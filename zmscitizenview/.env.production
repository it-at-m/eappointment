VITE_NODE_ENV=production
VITE_VUE_APP_API_URL=/buergeransicht/api/citizen
# For zmsautomation / ATAF containerized runs (hostname: citizenview)
VITE_VUE_APP_API_URL_CONTAINER="http://refarch-gateway:8080/buergeransicht/api/citizen"
VITE_VUE_APP_SERVICE_BASE_URL="https://stadt.muenchen.de/service/info/"

# Default host-page login baked into every image (zms-dev and zms-test).
# zms-demo and zms-load override kcUrl, kcRealm, and kcClientId in runtime-config.json.
# Magnolia embeds supply their own dbs-login and do not use these shells.
# SHOW_CITIZEN_LOGIN is also overridable from runtime-config.json.
SHOW_CITIZEN_LOGIN=true
# Fallback when the process env is unset at build time. A fetched appointment's
# placeholderEmail (ZMS_CITIZENAPI_PLACEHOLDER_EMAIL on the API) overrides this.
ZMS_CITIZENAPI_PLACEHOLDER_EMAIL=noreply-terminvereinbarung@muenchen.de
VITE_USE_LOCAL_CITIZEN_LOGIN=false
VITE_DBS_LOGIN_LOADER_URL=https://dbs-login-webcomponent-integration.muenchen.de/loader.js
VITE_KC_URL=https://ssodev.muenchen.de/auth
VITE_KC_REALM=A61
VITE_KC_CLIENT_ID=dbs-fragments

