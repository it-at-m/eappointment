# klg71/keycloakmigration 0.2.131 compiles the fat JAR for Java 24 (class 68)
# but still FROM azul/zulu-openjdk-alpine:23-jre-latest, so the published
# image cannot load MainKt. Rebase the same JAR/entrypoint onto a JRE that
# can run it. Drop --platform once upstream publishes a matching JRE.
ARG KEYCLOAKMIGRATION_IMAGE=docker.io/klg71/keycloakmigration:0.2.131@sha256:a311cce3b961062000e6e9ef08ecb5712f3ea81859beeee8cd0c836fe8e4f2cf
FROM --platform=linux/amd64 ${KEYCLOAKMIGRATION_IMAGE} AS migrator

FROM docker.io/library/eclipse-temurin:25-jre-alpine
WORKDIR /
COPY --from=migrator /keycloakmigration.jar /keycloakmigration.jar
COPY --from=migrator /entrypoint.sh /entrypoint.sh
ENTRYPOINT ["/bin/sh", "./entrypoint.sh"]
