{% extends "layout/main.twig" %}
{% from 'element/helper/snippets.twig' import headline1 %}
{% use "block/report/advancedInfo.twig" %}

{% block headline %}
    {{ headline1("Dienstleistungsstatistik") }}
{% endblock %}

{% block content %}
<div class="counter-view" data-includeurl="{{ includeUrl }}">
    <div class="report-index">
        {% embed "block/report/period.twig" with {"source":source, "items": requestPeriod, "selected": period} %}
        {% endembed %}

        <form class="form--base panel--heavy">
        {% embed "block/report/reportFilter.twig" %}
        {% endembed %}
        </form>

        {% embed "block/report/board.twig" with {'source':source, 'class': 'board--spaceless', "selected": period} %}
        {% import "element/helper/snippets.twig" as timeutils %}
        {% block board_body %}
        {% if selected or dateRange %}
            {% if exchangeRequest.period == "day" %}
                {% set start = date("%s-%s-%s"|format(exchangeRequest.firstDay.year, exchangeRequest.firstDay.month, exchangeRequest.firstDay.day)) %}
                {% set end = date("%s-%s-%s"|format(exchangeRequest.lastDay.year, exchangeRequest.lastDay.month, exchangeRequest.lastDay.day)) %}
                {% set days = start.diff(end).days %}
                {% set dateRange = [] %}
                {% for i in range(0, days) %}
                    {% set fullDate = start | date_modify("+" ~ i ~ " day") | date('Y-m-d') %}
                    {% set dateRange = dateRange|merge([fullDate]) %}
                {% endfor %}
            {% elseif exchangeRequest.period == "month" %}
                {% set startMonth = date("%s-%s-01"|format(exchangeRequest.firstDay.year, exchangeRequest.firstDay.month)) %}
                {% set endMonth = date("%s-%s-01"|format(exchangeRequest.lastDay.year, exchangeRequest.lastDay.month)) %}
                {% set sameYear = exchangeRequest.firstDay.year == exchangeRequest.lastDay.year %}
                {% set monthPattern = sameYear ? "LLL" : "LLL y" %}
                {% set dateRange = [] %}
                {% set cursor = startMonth %}
                {% for i in 0..240 %}
                    {% if cursor <= endMonth %}
                        {% set dateRange = dateRange|merge([cursor|date('Y-m')]) %}
                        {% set cursor = cursor|date_modify('+1 month') %}
                    {% endif %}
                {% endfor %}
            {% endif %}
            <div class="table-wrapper">
            <table class="table--base">
                <thead>
                    <tr>
                        <th class="statistik" style="width: 1%; white-space: nowrap;">
                            <span class="keinumbruch">
                                {% trans %}Dienstleistung{% endtrans %}
                            </span>
                        </th>
                    {% if exchangeRequest.period == "day" %}
                        <th class="statistik">Ø Bearbeitungsdauer</th>
                        <th class="statistik">Summe</th>
                    {% elseif exchangeRequest.period == "month" %}
                        <th class="statistik">{% if sameYear %}{{ exchangeRequest.firstDay.year }}{% else %}{% trans %}Summe{% endtrans %}{% endif %}</th>
                    {% endif %}
                    {% for date in dateRange %}
                        {% if exchangeRequest.period == "day" %}
                            <th class="statistik">{{ date|date('d.m.') }}</th>
                        {% elseif exchangeRequest.period == "month" %}
                            <th class="statistik">&nbsp;{{ (date ~ "-01")|format_date(pattern=monthPattern) }}</th>
                        {% endif %}
                    {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% set totalSum = 0 %}

                    {% set uncategorizedRequestKey = 'uncategorized' %}
                    {% set serviceNotProvidedKey = 'nonexistent' %}
                    {% for name, entry in exchangeRequest.data %}

                        {% if name != "average_processingtime" and name != "sum" %}
                        <tr{% if name == uncategorizedRequestKey or name == serviceNotProvidedKey %} class="report-board--request-stat-special"{% endif %}>
                            <th class="report-board--long-text">
                                {% if name == uncategorizedRequestKey %}
                                    Dienstleistung wurde nicht erfasst
                                {% elseif name == serviceNotProvidedKey %}
                                    Dienstleistung konnte nicht erbracht werden
                                {% else %}
                                    {{ name|trans }}
                                {% endif %}
                            </th>

                            {% if exchangeRequest.period == "day" %}
                                <td class="report-board--summary">
                                    {{ timeutils.formatMinutesToTime(exchangeRequest.data.average_processingtime[name]) }}
                                </td>
                            {% endif %}

                            <td class="report-board--summary">
                                {{ exchangeRequest.data.sum[name] }}
                            </td>

                            {% if name != uncategorizedRequestKey and name != serviceNotProvidedKey %}
                                {% set totalSum = totalSum + (exchangeRequest.data.sum[name]|default(0)) %}
                            {% endif %}

                            {% for date in dateRange %}
                                <td>
                                    <span class="{% if not entry[date].requestscount %}ausgegraut{% endif %}">
                                        {{ entry[date].requestscount|default("-") }}
                                    </span>
                                </td>
                            {% endfor %}
                        </tr>
                        {% endif %}
                    {% endfor %}

                    <tr>
                        <th class="report-board--long-text">Summe</th>

                        {% if exchangeRequest.period == "day" %}
                            <td class="report-board--summary">-</td>
                        {% endif %}

                        <td class="report-board--summary">
                            {{ totalSum }}
                        </td>

                        {% for date in dateRange %}
                            {% set dateSum = 0 %}
                            {% for name, entry in exchangeRequest.data %}
                                {% if name != "average_processingtime" and name != "sum"
                                    and name != uncategorizedRequestKey and name != serviceNotProvidedKey %}
                                    {% set dateSum = dateSum + (entry[date].requestscount|default(0)) %}
                                {% endif %}
                            {% endfor %}

                            <td class="report-board--summary">
                                {{ dateSum }}
                            </td>
                        {% endfor %}
                    </tr>
                </tbody>
            </table>
            </div>
        {% else %}
            {{ block("board_body_noperiod") }}
        {% endif %}
        {% endblock %}
        {% endembed %}
        </div>
    </div>
{% endblock %}
