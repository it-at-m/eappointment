exec_sql -e "DELETE FROM flyway_schema_history WHERE version > 1;" 2>/dev/null || true

info "Running Flyway migrations from $FLYWAY_DIR via Maven Flyway plugin..."
(
  cd "$PROJECT_ROOT/zmsautomation"
