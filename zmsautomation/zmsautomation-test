# One Maven process has a single cucumber.features value, so both profiles run as two calls.
ATAF_MAVEN_ARGS=()
HAS_TAG_FILTER=false
HAS_CUCUMBER_FEATURES=false
RUN_SPLIT_SUITES=false
for arg in "${MAVEN_ARGS[@]+"${MAVEN_ARGS[@]}"}"; do
  if [[ "$arg" == -Dcucumber.filter.tags=* ]]; then
    HAS_TAG_FILTER=true
    value="${arg#-Dcucumber.filter.tags=}"
    if [[ "$value" == *@ignore* ]]; then
      ATAF_MAVEN_ARGS+=("$arg")
    else
      ATAF_MAVEN_ARGS+=("-Dcucumber.filter.tags=($value) and not @ignore")
    fi
  elif [[ "$arg" == -Dcucumber.features=* ]]; then
    HAS_CUCUMBER_FEATURES=true
    ATAF_MAVEN_ARGS+=("$arg")
  elif [[ "$arg" == -P* ]]; then
    profiles="${arg#-P}"
    kept=""
    IFS=',' read -r -a profile_list <<< "$profiles"
    for profile in "${profile_list[@]}"; do
      profile="${profile#"${profile%%[![:space:]]*}"}"
      profile="${profile%"${profile##*[![:space:]]}"}"
      if [[ "$profile" == "ataf-api" || "$profile" == "ataf-ui" ]]; then
        continue
      fi
      kept="${kept:+$kept,}$profile"
    done
    if [[ -n "$kept" ]]; then
      ATAF_MAVEN_ARGS+=("-P${kept}")
    fi
  else
    ATAF_MAVEN_ARGS+=("$arg")
  fi
done
