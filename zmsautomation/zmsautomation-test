export MYSQL_PORT="${MYSQL_PORT:-tcp://db:3306}"
export MYSQL_DATABASE="${MYSQL_DATABASE:-db}"
export MYSQL_USER="${MYSQL_USER:-db}"
export MYSQL_PASSWORD="${MYSQL_PASSWORD:-db}"
export MYSQL_ROOT_PASSWORD="${MYSQL_ROOT_PASSWORD:-root}"
export CACHE_DIR="${CACHE_DIR:-/var/www/html/cache}"

# xdebug.mode in the mounted ini is debug,develop with start_with_request=yes.
# XDEBUG_MODE overrides that for every PHP process this script starts.
export XDEBUG_MODE=off
XDEBUG_OFF_INI="/usr/local/etc/php/conf.d/zz-zmsautomation-xdebug-off.ini"

export BASE_URI="${BASE_URI:-http://web/terminvereinbarung/api/2}"
