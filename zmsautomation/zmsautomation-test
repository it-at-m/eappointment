info "Database tables after Flyway:"
exec_sql -e "SELECT table_name AS 'Table Name', table_rows AS 'Row Count' FROM information_schema.tables WHERE table_schema = '$DB_NAME' ORDER BY table_name;" || true

# 6. PHP Migrations (inherit ZMS_TIMEADJUST from env)
section "6. PHP Migrations"
( cd "$ZMS_REST_DIR" && bin/configure && bin/migrate --update )

# 7. Hourly Cronjob (inherit ZMS_TIMEADJUST from env)
section "7. Hourly Cronjob"
export ZMS_CRONROOT=1
export ZMS_ENV="${ZMS_ENV:-dev}"
if ! run_hourly_with_retries; then
  if [[ "${SKIP_DDLDB_FALLBACK:-}" == "1" ]]; then
    warn "SKIP_DDLDB_FALLBACK=1 — hourly DLDB import failed and bundled fixtures are disabled"
    exit 1
  fi
  warn "Live Munich SADB import failed; falling back to bundled DLDB fixtures."
  install_dldb_bundled_fixtures || exit 1
fi
clear_caches

section "8. Minutly Cronjob"
export ZMS_CRONROOT=1
export ZMS_ENV="${ZMS_ENV:-dev}"
info "Running minutly cron with ZMS_TIMEADJUST=$ZMS_TIMEADJUST ..."
(
  cd "$ZMS_REST_DIR" \
  && ZMS_TIMEADJUST="$ZMS_TIMEADJUST" ZMS_ENV="$ZMS_ENV" ZMS_CRONROOT=1 ./cron/cronjob.minutly
) || true

info "Forcing slot calculation fallback (mocked time) ..."
(
  cd "$ZMS_REST_DIR" \
  && ZMS_TIMEADJUST="$ZMS_TIMEADJUST" php bin/calculateSlots --commit --delete
) || true

# 9. Health Checks (5 min total; 15s per try; curl uses explicit --noproxy)
#
# citizenapi / citizenapi-available-calendar use CITIZEN_API_BASE_URI → http://localhost/.../api/citizen/...
# That hits zms-web (PHP) directly — refarch-gateway is NOT on that path, so gateway logs stay empty.
# Browser + Vite use http://refarch-gateway:8080/buergeransicht/api/citizen/... — we ping that too so
# gateway sees traffic and DEBUG logs prove the route. Skip with SKIP_REFARCH_GATEWAY_HEALTH=1 if no gateway.
section "9. Health Checks"

join_url(){ local b="${1%/}"; local p="${2#/}"; printf '%s/%s\n' "$b" "$p"; }

HEALTH_MAX_WAIT="${HEALTH_MAX_WAIT:-300}"          # total seconds
HEALTH_INTERVAL="${HEALTH_INTERVAL:-5}"            # seconds between tries
