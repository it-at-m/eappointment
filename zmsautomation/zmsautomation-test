}

invoke_maven_suite() {
  local suite_name="$1"
  local max_attempts="$2"
  shift 2
  local attempt=1
  local suite_exit=0
  local attempt_log
  while (( attempt <= max_attempts )); do
    attempt_log="$PROJECT_ROOT/zmsautomation/target/maven-test-${suite_name}-attempt-${attempt}.log"
    info "Starting ${suite_name} Maven test attempt ${attempt}/${max_attempts}"
    mvn -B -DtrimStackTrace=false \
      "${PLATFORM_ARGS[@]}" \
      -DBASE_URI="$BASE_URI" \
      -DCITIZEN_API_BASE_URI="$CITIZEN_API_BASE_URI" \
      -DZMS_CONFIG_SECURE_TOKEN="$ZMS_CONFIG_SECURE_TOKEN" \
      -Dbrowser="${ZMS_BROWSER:-chrome}" \
      -Dtestautomation.browser="${ZMS_BROWSER:-chrome}" \
      -Dwebdriver.gecko.driver="${WEBDRIVER_GECKO_DRIVER:-/usr/local/bin/geckodriver}" \
      -Dwebdriver.chrome.driver="${WEBDRIVER_CHROME_DRIVER:-/usr/bin/chromedriver}" \
      -Dwebdriver.edge.driver="${WEBDRIVER_EDGE_DRIVER:-/usr/local/bin/msedgedriver}" \
      -DSCREENSHOT_EVERY_STEP="${SCREENSHOT_EVERY_STEP}" \
      -Dsso.username="$SSO_USER" \
      -Dsso.password="$SSO_PASSWORD" \
      test "$@" 2>&1 | tee "$attempt_log"
    suite_exit=${PIPESTATUS[0]}

    if [[ $suite_exit -eq 0 ]]; then
      return 0
    fi
    if (( attempt < max_attempts )) && is_webdriver_bootstrap_failure "$attempt_log"; then
      warn "Detected WebDriver bootstrap failure on ${suite_name} attempt ${attempt}; retrying in ${RETRY_DELAY_SECONDS}s"
      sleep "$RETRY_DELAY_SECONDS"
      attempt=$((attempt + 1))
      continue
    fi
    return "$suite_exit"
  done
  return "$suite_exit"
}

PLATFORM_ARGS=()
if [[ "${ZMS_BROWSER:-chrome}" == "edge" ]]; then
  EDGE_PLATFORM="${TESTAUTOMATION_PLATFORM_NAME:-linux}"
