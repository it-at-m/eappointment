# 12. Test Results
section "12. Test Results"
print_surefire_dir() {
  local dir="$1"
  local label="$2"
  if [[ ! -d "$dir" ]]; then
    return 0
  fi
  info "${label}: ${dir}"
  ls -la "$dir"
  local f
  for f in "$dir"/*.txt; do
    if [[ -f "$f" ]]; then
      echo "==== $f ===="
      cat "$f"
      echo
    fi
  done
}

print_combined_result() {
  local tests=0 failures=0 errors=0 skipped=0
  local found=false
  local dir f line t fai err sk
  for dir in \
    "$PROJECT_ROOT/zmsautomation/target/surefire-reports-api" \
    "$PROJECT_ROOT/zmsautomation/target/surefire-reports"
  do
    [[ -d "$dir" ]] || continue
    for f in "$dir"/*.txt; do
      [[ -f "$f" ]] || continue
      line="$(grep -m1 '^Tests run:' "$f" || true)"
      [[ -n "$line" ]] || continue
      found=true
      read -r t fai err sk <<<"$(printf '%s' "$line" | sed -E 's/Tests run: ([0-9]+), Failures: ([0-9]+), Errors: ([0-9]+), Skipped: ([0-9]+).*/\1 \2 \3 \4/')"
      tests=$((tests + t))
      failures=$((failures + fai))
      errors=$((errors + err))
      skipped=$((skipped + sk))
    done
  done
  if [[ "$found" == true ]]; then
    info "Combined result: Tests run: ${tests}, Failures: ${failures}, Errors: ${errors}, Skipped: ${skipped}"
  fi
}

