# Cleanup function to clear REST module data folder (preserve .gitignore)
cleanup_data_folder() {
  if [ -d "$ZMS_REST_DIR/data" ]; then
    find "$ZMS_REST_DIR/data" -mindepth 1 -not -name ".gitignore" -delete || warn "Failed to clean data folder"
    [ -f "$ZMS_REST_DIR/data/.gitignore" ] || printf "*\n!.gitignore\n" > "$ZMS_REST_DIR/data/.gitignore"
  fi
}

# Clean up QEMU/geckodriver crash dump files that can accumulate on ARM hosts.
cleanup_qemu_geckodriver_cores() {
  local dump_dir="$PROJECT_ROOT/zmsautomation"
  if [ ! -d "$dump_dir" ]; then
    return 0
  fi

  local removed=0
  while IFS= read -r -d '' f; do
    rm -f "$f" || true
    removed=$((removed + 1))
  done < <(find "$dump_dir" -maxdepth 1 -type f -name 'qemu_geckodriver_*.core' -print0 2>/dev/null)

  if (( removed > 0 )); then
    info "Removed ${removed} qemu_geckodriver core dump file(s)."
  fi
}

# Clear caches
clear_caches() {
  if [[ -n "${CACHE_DIR:-}" && -d "$CACHE_DIR" ]]; then
    info "Clearing caches in $CACHE_DIR..."
    find "$CACHE_DIR" -mindepth 1 -delete || warn "Failed to clear caches"
  else
    warn "CACHE_DIR not set or does not exist"
  fi
}

# Database helper function
exec_sql() {
  mysql --ssl=0 -h "$DB_HOST" -P "$DB_PORT" -u "$DB_USER" --password="$DB_PASSWORD" "$DB_NAME" "$@"
}

exec_sql_root() {
  mysql --ssl=0 -h "$DB_HOST" -P "$DB_PORT" -u root --password="${MYSQL_ROOT_PASSWORD:-root}" "$@"
}

# Backup database
backup_db() {
  info "Backing up database to $BACKUP_FILE..."
  mysqldump --ssl=0 -h "$DB_HOST" -P "$DB_PORT" -u "$DB_USER" --password="$DB_PASSWORD" "$DB_NAME" | gzip > "$BACKUP_FILE"
  info "Backup completed."
}

# Restore database
restore_db() {
  if [[ "$SKIP_DB_RESTORE" == "1" ]]; then
    info "Skipping database restore (SKIP_DB_RESTORE=1)."
    return 0
  fi
  if [[ -f "$BACKUP_FILE" ]]; then
    info "Restoring database from $BACKUP_FILE..."
    gunzip < "$BACKUP_FILE" | exec_sql
    info "Database restored."
  else
    warn "No backup file found to restore."
  fi
}

# --- Freeze Firefox time only (no global LD_PRELOAD) ------------------------
write_firefox_freeze_wrapper() {
  cat >/usr/local/bin/firefox-frozen <<'EOF'
#!/bin/bash
FAKE_NOW="${FAKETIME_TARGET:-${ZMS_TIMEADJUST:-2026-03-02 10:00:00}}"
SO="/usr/lib/x86_64-linux-gnu/faketime/libfaketime.so.1"
[ -f "$SO" ] || SO="/usr/lib/faketime/libfaketime.so.1"
# Only Firefox sees faketime (not geckodriver)
export FAKETIME="@${FAKE_NOW}"
export FAKETIME_NO_CACHE=1
export FAKETIME_DONT_RESET=1
export FAKETIME_DONT_FAKE_MONOTONIC=1     # important for Gecko
export MOZ_DISABLE_CONTENT_SANDBOX=1      # avoid sandbox conflict
export LD_PRELOAD="$SO${LD_PRELOAD+:$LD_PRELOAD}"
exec /usr/bin/firefox-esr "$@"
EOF
  chmod +x /usr/local/bin/firefox-frozen
}

switch_firefox_to_frozen() {
  # Remember original target for restore
  export __PREV_FIREFOX_BIN_TARGET="$(readlink -f /usr/bin/firefox || echo /usr/bin/firefox-esr)"
  ln -sf /usr/local/bin/firefox-frozen /usr/bin/firefox
  info "Firefox binary switched to wrapper (/usr/local/bin/firefox-frozen)"
}

restore_firefox_binary() {
  if [ -n "${__PREV_FIREFOX_BIN_TARGET-}" ] && [ -e "$__PREV_FIREFOX_BIN_TARGET" ]; then
    ln -sf "$__PREV_FIREFOX_BIN_TARGET" /usr/bin/firefox
    info "Firefox binary restored to $__PREV_FIREFOX_BIN_TARGET"
  fi
}

# Altcha needs crypto.subtle. http://citizenview is not a secure context; localhost is.
# Debian's /usr/bin/chromium sources /etc/chromium.d before it starts the browser.
CHROMIUM_SECURE_CONTEXT_DROPIN="/etc/chromium.d/zms-secure-context"
enable_citizenview_secure_context() {
  local origin="http://citizenview:${CITIZENVIEW_PORT:-8082}"
  if [[ ! -d /etc/chromium.d ]]; then
    warn "No /etc/chromium.d; cannot mark ${origin} as a secure context"
    return 0
  fi
  cat >"$CHROMIUM_SECURE_CONTEXT_DROPIN" <<EOF
export CHROMIUM_FLAGS="\$CHROMIUM_FLAGS --unsafely-treat-insecure-origin-as-secure=${origin} --disable-dev-shm-usage --disable-gpu"
EOF
  info "Chromium will treat ${origin} as a secure context (Altcha)"
}

# ATAF 0.3.4 ships Selenium 4.46, which speaks CDP 148-150. A newer Chromium
# (153 in this container) makes ChromeDriver report
# "Timed out receiving message from renderer" on the first navigation.
# Same pin as .github/workflows/zmsautomation-workflow.yaml.
CHROMIUM_CDP_MAJOR=150
CHROMIUM_APT_PIN="150.0.7871.181-1~deb13u1"
ensure_chromium_matches_selenium() {
  [[ "${ZMS_BROWSER:-chrome}" == "chrome" ]] || return 0
  local current="" major=""
  if command -v chromium >/dev/null 2>&1; then
    current="$(chromium --version 2>/dev/null | awk '{print $2}' || true)"
  fi
  major="${current%%.*}"
  if [[ "$major" == "$CHROMIUM_CDP_MAJOR" ]]; then
    info "Chromium ${current} matches Selenium CDP ${CHROMIUM_CDP_MAJOR}"
    return 0
  fi
  if ! command -v apt-get >/dev/null 2>&1; then
    warn "Chromium ${current:-missing} is not CDP ${CHROMIUM_CDP_MAJOR}, and apt-get is unavailable"
    return 0
  fi
  info "Chromium ${current:-missing} is not CDP ${CHROMIUM_CDP_MAJOR}; installing ${CHROMIUM_APT_PIN}"
  apt-get update
  if ! apt-get install -s -y --allow-downgrades \
      "chromium-common=${CHROMIUM_APT_PIN}" \
      "chromium=${CHROMIUM_APT_PIN}" \
      "chromium-driver=${CHROMIUM_APT_PIN}" >/dev/null 2>&1; then
    warn "Pinned Chromium ${CHROMIUM_APT_PIN} is not installable. UI tests need Chromium ${CHROMIUM_CDP_MAJOR}."
    return 0
  fi
  apt-get install -y --no-install-recommends --allow-downgrades \
    "chromium-common=${CHROMIUM_APT_PIN}" \
    "chromium=${CHROMIUM_APT_PIN}" \
    "chromium-driver=${CHROMIUM_APT_PIN}"
  apt-mark hold chromium chromium-driver chromium-common
}

disable_citizenview_secure_context() {
  if [[ -f "$CHROMIUM_SECURE_CONTEXT_DROPIN" ]]; then
    rm -f "$CHROMIUM_SECURE_CONTEXT_DROPIN"
    info "Removed Chromium secure-context drop-in"
  fi
}

reload_php_service() {
  local master=""
  if [[ -r /usr/local/var/run/php-fpm.pid ]]; then
    master="$(cat /usr/local/var/run/php-fpm.pid)"
  elif [[ -r /run/php-fpm.pid ]]; then
    master="$(cat /run/php-fpm.pid)"
  elif [[ -r /var/run/php-fpm.pid ]]; then
    master="$(cat /var/run/php-fpm.pid)"
  else
    master="$(pgrep -o -x php-fpm 2>/dev/null || true)"
  fi
  if [[ -n "$master" ]]; then
    kill -USR2 "$master"
    info "Reloaded php-fpm"
    return 0
  fi
  if command -v apachectl >/dev/null 2>&1; then
    apachectl graceful
    info "Reloaded Apache"
    return 0
  fi
  return 1
}

# Web workers are already running, so they do not see this script's environment.
# An ini loaded after 99-xdebug.ini turns the debugger off until cleanup.
disable_xdebug_for_web() {
  info "Xdebug disabled for this run (XDEBUG_MODE=off)"
  if [[ ! -d /usr/local/etc/php/conf.d || ! -w /usr/local/etc/php/conf.d ]]; then
    warn "PHP conf.d is not writable; already-running web workers may still start Xdebug"
    return 0
  fi
  printf '%s\n' 'xdebug.mode=off' > "$XDEBUG_OFF_INI"
  reload_php_service || warn "PHP service was not reloaded; web requests may still start Xdebug"
}

restore_xdebug_for_web() {
  if [[ -n "${XDEBUG_OFF_INI:-}" && -f "$XDEBUG_OFF_INI" ]]; then
    rm -f "$XDEBUG_OFF_INI"
    info "Restored Xdebug for the web SAPI"
    reload_php_service || warn "PHP service was not reloaded; Xdebug stays off until zms-web restarts"
  fi
}

cleanup_on_exit() {
  info "Running cleanup..."

  restore_xdebug_for_web || true

  # 1. Restore time first (most critical for developer environment)
  restore_firefox_binary  || true
  disable_citizenview_secure_context || true
  
  # 2. Restore database
  restore_db
  
  # 3. Restore Keycloak configs
  restore_keycloak
  
  # 4. Clear Flyway test migrations (skip when DB restore is disabled)
  if [[ -n "${BACKUP_FILE:-}" && "$SKIP_DB_RESTORE" != "1" ]]; then
    info "Clearing test data migrations from flyway_schema_history..."
    exec_sql -e "DELETE FROM flyway_schema_history WHERE version > 1;" 2>/dev/null || true
  fi
  
  # 5. Clear caches
  clear_caches
  
  # 6. Clean data folder
  cleanup_data_folder

  # 7. Remove stale qemu/geckodriver crash dumps
  cleanup_qemu_geckodriver_cores
  
  info "Cleanup completed."
}


backup_and_rewrite_keycloak() {
  local file="$1"
  if [[ -f "$file" ]]; then
    cp "$file" "$file.bak"
    sed -i 's/localhost:8090/localhost/g' "$file"
    info "Keycloak config rewritten (8090→80): $file"
  else
    warn "Keycloak config not found: $file"
  fi
}

restore_keycloak() {
  for f in "$KEYCLOAK_STATISTIC_JSON" "$KEYCLOAK_ADMIN_JSON"; do
    if [[ -f "${f}.bak" ]]; then
      mv "${f}.bak" "$f"
      info "Keycloak config restored: $f"
    fi
  done
}

# Drop all tables
drop_all_tables() {
  info "Dropping all existing tables..."
  local drop_sql="SET FOREIGN_KEY_CHECKS = 0;
SET SESSION group_concat_max_len = 1000000;
SET @tables = (SELECT GROUP_CONCAT(CONCAT('\`', table_name, '\`')) FROM information_schema.tables WHERE table_schema = '$DB_NAME' AND table_type = 'BASE TABLE');
SET @sql = IF(@tables IS NULL OR @tables = '', 'DO 0', CONCAT('DROP TABLE IF EXISTS ', @tables));
PREPARE stmt FROM @sql;
EXECUTE stmt;
DEALLOCATE PREPARE stmt;
SET FOREIGN_KEY_CHECKS = 1;"
  echo "$drop_sql" | exec_sql
  info "Tables dropped."
}

install_dldb_bundled_fixtures() {
  # Offline copy of a Munich SADB export (same shape as cronjob.hourly → updateDldbData).
  info "Installing bundled DLDB fixtures from $DLDB_FIXTURE_DIR ..."
  if [[ ! -f "$DLDB_FIXTURE_DIR/services_de.json" || ! -f "$DLDB_FIXTURE_DIR/locations_de.json" ]]; then
    warn "Bundled DLDB fixtures are missing under $DLDB_FIXTURE_DIR"
    return 1
  fi
  mkdir -p "$ZMS_REST_DIR/data"
  for f in services_de.json locations_de.json topic_de.json services_en.json locations_en.json authority_de.json settings.json; do
    if [[ -f "$DLDB_FIXTURE_DIR/$f" ]]; then
      cp -f "$DLDB_FIXTURE_DIR/$f" "$ZMS_REST_DIR/data/$f"
    fi
  done
  (
    cd "$ZMS_REST_DIR"
    bin/updateDldbData --commit
  ) || {
    warn "updateDldbData failed after copying bundled DLDB fixtures"
    return 1
  }
  info "Bundled DLDB fixtures installed."
  return 0
}

run_hourly_with_retries() {
  # Run hourly cronjob with up to 5 retries (6 attempts total).
  # Munich index fetch uses a 45s HTTP timeout — short delays rarely help; use longer backoff.
  local cmd=("$ZMS_REST_DIR/cron/cronjob.hourly" --city=munich)
  local delays=(0 15 30 45 60 90) # initial attempt has no delay
  local max_attempts=${#delays[@]}
  local attempt delay

  for i in "${!delays[@]}"; do
    attempt=$((i + 1))
    delay="${delays[$i]}"

    if (( delay > 0 )); then
      info "Waiting ${delay}s before hourly cronjob attempt ${attempt}/${max_attempts}..."
      sleep "$delay"
    fi

    info "Running hourly cronjob (attempt ${attempt}/${max_attempts})..."
    if "${cmd[@]}"; then
      info "Hourly cronjob succeeded on attempt ${attempt}/${max_attempts}."
      return 0
    fi

    if (( attempt < max_attempts )); then
      warn "Hourly cronjob failed on attempt ${attempt}/${max_attempts}; will retry."
    fi
  done

  warn "Hourly cronjob failed after ${max_attempts} attempts."
  return 1
}

