{
  "manifest_version": 2,
  "name": "ZMS stub window.print",
  "version": "1.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "zms-stub-print@eappointment.local"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://web/*"
      ],
      "js": ["stub.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
