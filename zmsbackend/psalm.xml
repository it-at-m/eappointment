<?xml version="1.0"?>
<psalm
    errorLevel="7"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    findUnusedBaselineEntry="true"
    findUnusedCode="false"
>
    <projectFiles>
        <directory name="src" />
        <file name="config.example.php" />
        <file name="bootstrap.php" />
        <file name="routing.php" />
        <ignoreFiles>
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>
    <issueHandlers>
        <!-- Psalm narrows typed string/bool consts to their literal values; module App overrides are valid PHP. -->
        <InvalidClassConstantType errorLevel="suppress" />
        <LessSpecificClassConstantType errorLevel="suppress" />
        <!-- Fluent builder methods exist on Select/Insert/Update/Delete; Query\Base types $query as abstract Query. -->
        <UndefinedMethod>
            <errorLevel type="suppress">
                <referencedMethod name="BO\Zmsbackend\Query\Builder\Query::select" />
                <referencedMethod name="BO\Zmsbackend\Query\Builder\Query::from" />
                <referencedMethod name="BO\Zmsbackend\Query\Builder\Query::where" />
                <referencedMethod name="BO\Zmsbackend\Query\Builder\Query::orWhere" />
                <referencedMethod name="BO\Zmsbackend\Query\Builder\Query::whereIn" />
                <referencedMethod name="BO\Zmsbackend\Query\Builder\Query::having" />
                <referencedMethod name="BO\Zmsbackend\Query\Builder\Query::orHaving" />
                <referencedMethod name="BO\Zmsbackend\Query\Builder\Query::join" />
                <referencedMethod name="BO\Zmsbackend\Query\Builder\Query::leftJoin" />
                <referencedMethod name="BO\Zmsbackend\Query\Builder\Query::rightJoin" />
                <referencedMethod name="BO\Zmsbackend\Query\Builder\Query::groupBy" />
                <referencedMethod name="BO\Zmsbackend\Query\Builder\Query::orderBy" />
                <referencedMethod name="BO\Zmsbackend\Query\Builder\Query::table" />
                <referencedMethod name="BO\Zmsbackend\Query\Builder\Query::values" />
                <referencedMethod name="BO\Zmsbackend\Query\Builder\Query::value" />
                <referencedMethod name="BO\Zmsbackend\Query\Builder\Query::limit" />
                <referencedMethod name="BO\Zmsbackend\Query\Builder\Query::offset" />
                <referencedMethod name="BO\Zmsbackend\Query\Builder\Query::resetSelect" />
            </errorLevel>
        </UndefinedMethod>
    </issueHandlers>
</psalm>
