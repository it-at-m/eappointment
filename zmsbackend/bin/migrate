#!/usr/bin/env php
<?php
require_once(__DIR__."/script_bootstrap.php");

$updateOption = count(preg_grep('#^--update$#', $argv)) == 1;

$phase = null;
$phaseArguments = preg_grep('#^--phase=#', $argv);
if ($phaseArguments) {
    $phase = substr((string) reset($phaseArguments), strlen('--phase='));
    if (!in_array($phase, ['expand', 'contract'], true)) {
        \App::$log->error('Invalid migration phase', [
            'phase' => $phase,
            'expected' => ['expand', 'contract'],
        ]);
        exit(1);
    }
}

$migrationFiles = preg_grep('#^[^-]#', array_slice($argv, 1));

    \App::$log->info('Checking for open migrations', ['update' => $updateOption, 'phase' => $phase]);

if ($migrationFiles) {
    $added = \BO\Zmsbackend\Cli\Db::startMigrations($migrationFiles, $updateOption, $phase);
} else {
    $migrations = realpath(__DIR__ . '/../migrations/');
    $added = \BO\Zmsbackend\Cli\Db::startMigrations($migrations, $updateOption, $phase);

}
if (!$updateOption && $added) {
    \App::$log->notice('Migrations pending — run with --update to activate', [
        'command' => $argv[0] . ' --update ' . implode(' ', array_slice($argv, 1)),
        'pending' => $added,
    ]);
}

if ($updateOption && $added > 0) {
    $cacheClearFailed = false;
    if (\App::$cache instanceof \Psr\SimpleCache\CacheInterface) {
        try {
            if (\App::$cache->clear() === false) {
                $cacheClearFailed = true;
                \App::$log->error('Failed to clear the API cache after applying migrations', [
                    'applied' => $added,
                ]);
            } else {
                \App::$log->info('Cleared the API cache after applying migrations', [
                    'applied' => $added,
                ]);
            }
        } catch (\Throwable $exception) {
            $cacheClearFailed = true;
            \App::$log->error('Failed to clear the API cache after applying migrations', [
                'error' => $exception->getMessage(),
            ]);
        }
    }

    $warmup = __DIR__ . '/warmupCitizenapiSourceCache';
    $command = escapeshellarg(\PHP_BINARY) . ' ' . escapeshellarg($warmup) . ' --commit';
    passthru($command);
    if ($cacheClearFailed) {
        exit(1);
    }
}
