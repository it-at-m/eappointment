#!/usr/bin/env php
<?php

require_once(__DIR__ . "/script_bootstrap.php");

$commit = in_array('--commit', $argv, true);

if (class_exists('\App') && isset(\App::$now)) {
    $now = \App::$now;
} else {
    $now = new \DateTimeImmutable('now');
}

$job = new \BO\Zmsbackend\Helper\ProcessSearchHistoryCleanUp();
$job->startProcessing($now, $commit);

if (!$commit) {
    \App::$log->notice(
        'Use with --commit to delete process search history entries.'
    );
}