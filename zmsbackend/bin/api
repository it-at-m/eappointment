#!/usr/bin/env php
<?php
require(__DIR__ . '/../bootstrap.php');
use League\CLImate\CLImate;

$commandname= $argv[0];
$climate =new CLImate();

if (count($argv) < 2) {
    $climate->out("
Usage: $commandname [command]

COMMANDS:");
    $padding = $climate->padding(10)->char(' ');
    $padding->label('info')->result('Show information about the API');
    $padding->label('status')->result('Show status informations');
    $padding->label('config')->result('Show and change api configuration');
} else {
    $commandName = $argv[1];
    $commands = [
        'config' => \BO\Zmsbackend\Cli\Config::class,
        'db' => \BO\Zmsbackend\Cli\Db::class,
        'info' => \BO\Zmsbackend\Cli\Info::class,
        'status' => \BO\Zmsbackend\Cli\Status::class,
    ];
    $commandClass = $commands[strtolower((string) $commandName)] ?? null;
    if ($commandClass !== null) {
        try {
            $command = new $commandClass();
            $command->cli($argv, $climate);
        } catch (\Exception $exception) {
            $climate->to('error')->red("Exception: " . $exception->getMessage());
            $climate->to('error')->out("$exception");
            exit($exception->getCode());
        }
    } else {
        $climate->to('error')->red("Could not find command $commandName");
    }
}
