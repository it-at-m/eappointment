#!/usr/bin/env php
<?php
require_once(__DIR__."/script_bootstrap.php");

$usage = <<<EOS
Usage: {$argv[0]} [requestJsonFile] [providerJsonFile]
        ATTENTION! Delete services from provider json that does not exists in request json file. USE WITH CAUTION!
        requestJsonFile        absolute path to json file with dldb exported services
        providerJsonFile       absolute path to json file with dldb exported providers

        !!!!!!!!!!!!!!!!!!!!!!!
        !! DATA LOSS WARNING !!
        !!!!!!!!!!!!!!!!!!!!!!!
EOS;

if (! $argv[1] || ! $argv[2]) {
            \App::$log->notice('deleteUnmatchedRequestsFromProviderExport usage', ['usage' => trim($usage)]);
    exit;
}

$requestFile = localExportFile($argv[1]);
$providerFile = localExportFile($argv[2]);
$requestJson = json_decode(file_get_contents($requestFile), true);
$providerJson = json_decode(file_get_contents($providerFile), true);

$requestIdList = array();
foreach ($requestJson['data'] as $key => $item) {
    if (! in_array($item['id'], $requestIdList)) {
        $requestIdList[] = $item['id'];
    }
}

$exists = false;
$all = 0;
foreach ($providerJson['data'] as $providerKey => $providerItem) {
    $counter = 0;
    $deletedIds = [];
    foreach ($providerItem['services'] as $serviceKey => $providerRequestItem) {
        if (! in_array($providerRequestItem['service'], $requestIdList)) {
            $counter++;
            $deletedIds[] = $providerRequestItem['service'];
            unset($providerJson['data'][$providerKey]['services'][$serviceKey]);
        }
    }
    $providerJson['data'][$providerKey]['services'] = array_values($providerJson['data'][$providerKey]['services']);
    if ($counter) {
                    \App::$log->info('Deleted services for provider', [
                'count' => $counter,
                'ids' => $deletedIds,
                'provider' => $providerItem['name'],
            ]);
        $all += $counter;
    }
}
    \App::$log->info('Deleted services in total', ['count' => $all]);

file_put_contents($providerFile, json_encode($providerJson, JSON_PRETTY_PRINT));

/**
 * @psalm-taint-escape file
 * @psalm-taint-escape ssrf
 */
function localExportFile(string $path): string
{
    $hasStreamWrapper = preg_match('#^[a-z][a-z0-9+.-]*://#i', $path) === 1;
    $real = (!$hasStreamWrapper && !str_contains($path, "\0")) ? realpath($path) : false;
    if ($real === false || !is_file($real)) {
        \App::$log->error('Export file is not a local file');
        exit(1);
    }

    return $real;
}
