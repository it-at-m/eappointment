#!/usr/bin/env php
<?php

require_once(__DIR__ . '/script_bootstrap.php');

$commit = (bool) preg_grep('#^--commit$#', $argv);
$now = \App::$now ?? new \DateTimeImmutable('now');

\App::$log->notice('Convert locations to a 5-minute slot', [
    'usage' => "Usage: {$argv[0]} [--commit]",
    'database' => \BO\Zmsbackend\Connection\Select::$writeSourceName,
    'commit' => $commit,
]);

try {
    $report = (new \BO\Zmsbackend\Helper\FiveMinuteSlotConversion())->convert($now, $commit);
} catch (\RuntimeException $exception) {
    \App::$log->error($exception->getMessage());
    exit(1);
}

\App::$log->info('Five-minute slot conversion', [
    'written' => $commit,
    'openingHours' => $report['openingHours'],
    'followUps' => $report['followUps'],
    'caps' => $report['caps'],
    'providers' => $report['providers'],
    'unchangedCaps' => $report['unchangedCaps'],
]);

if (!$commit) {
    \App::$log->notice('Dry run only. Stop updateDldbData and calculateSlots, then run again with --commit.');
}
