                                },
                                "confirmationEnabled": {
                                    "type": [
                                        "boolean",
                                        "number"
                                    ],
                                    "description": "true if client should get a notification to confirm that notifications are enabled for him\/her",
                                    "default": false
                                },
                                "deactivatedText": {
                                    "type": "string",
