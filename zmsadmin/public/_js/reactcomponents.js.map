                                    "description": "last possible waiting number for ticket printer",
                                    "default": 999
                                },
                                "maxNumberContingent": {
                                    "type": "number",
                                    "description": "contingent of given waiting numbers for ticket printer per day",
                                    "maximum": 999,
                                    "default": 999
