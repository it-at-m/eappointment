                        "notificationsAmendmentEnabled": true,
                        "notificationsEnabled": true,
                        "notificationsDelay": 30
                    },
                    "workstation": {
                        "emergencyEnabled": false,
                        "emergencyRefreshInterval": 10
                    }
                },
                "provider": {
                    "contact": {
                        "city": "Schönefeld",
                        "country": "Germany",
                        "lat": 52.345,
                        "lon": 13.456,
                        "name": "Flughafen Schönefeld, Landebahn",
                        "postalCode": "15831",
                        "region": "Brandenburg",
                        "street": "Zaunstraße",
                        "streetNumber": "1"
                    },
                    "id": 123456,
                    "name": "Flughafen Schönefeld, Aufsicht",
                    "source": "dldb"
                },
                "shortName": "Zentrale",
                "status": {
                    "emergency": {
                        "activated": false
