                        "startInDaysDefault": 2
                    },
                    "client": {
                        "alternateAppointmentUrl": "https:\/\/service.berlin.de",
                        "amendmentLabel": "Zusatzinformationen zum Anliegen",
                        "emailRequired": false,
                        "telephoneActivated": true,
