                    //console.log('arrow down');
                    newIndex = (index + length + 1) % length;
                    submenuTriggerArray[newIndex].focus();
                    event.preventDefault();
                    break;
                case "Space":
                case " ":
                    //console.log('space');
                    toggleSubmenu(index);
