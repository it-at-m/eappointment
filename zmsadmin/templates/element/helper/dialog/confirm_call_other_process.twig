
{% embed "block/scaffholding/board.twig" with {'class': 'dialog'} %}
    {% block board_title %}<i aria-hidden="true" title="{{ ("Kunde in Bearbeitung")|trans }}" class="fas fa-info-circle"></i> {% trans %}Kunde in Bearbeitung{% endtrans %}{% endblock %}
    {% block board_body %}
        <p>
            {% trans %}Es befindet sich bereits ein Kunde in Bearbeitung. Möchten Sie den aktuellen Termin beenden und den ausgewählten Kunden aufrufen?{% endtrans %}
        </p>
        {% if name or id %}
        <p>
            <strong>{% trans %}Ausgewählter Kunde{% endtrans %}:</strong>
            {% if name %}{{ name }}{% endif %}{% if name and id %} · {% endif %}{% if id %}{% trans %}Wartenr.{% endtrans %} {{ id }}{% endif %}
        </p>
        {% endif %}
        <div class="form-actions">
            <a data-action-ok class="button button--default button-ok" href="#">{% trans %}Aktuellen Termin abschließen und Kunden aufrufen{% endtrans %}</a>
            <a data-action-abort class="button button--diamond button-abort" href="#">{% trans %}Zurück zum aktuellen Vorgang{% endtrans %}</a>
        </div>
    {% endblock %}

{% endembed %}
