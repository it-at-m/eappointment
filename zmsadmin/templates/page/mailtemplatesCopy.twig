{% extends "layout/main.twig" %}
{% from 'element/helper/snippets.twig' import headline1 %}

{% block headline %}
    {{ headline1(pageTitle) }}
{% endblock %}

{% block content %}
    {{ parent() }}

    <style>
        .mailtemplates-copy-location-selector {
            max-width: 95rem;
        }

        .mailtemplates-copy-location-selector .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 0.5rem;
        }

        .mailtemplates-copy-location-selector .header label {
            margin: 0;
            font-weight: bold;
        }

        .mailtemplates-copy-location-selector .btn-icon {
            background: transparent;
            border: 1px solid #000;
            border-radius: 0.25rem;
            padding: 0.25rem;
            cursor: pointer;
            line-height: 1;
        }

        .mailtemplates-copy-location-selector .btn-icon:hover {
            background: rgba(0, 123, 255, 0.1);
        }
    </style>

    {% if formError %}
        <div class="message message--error" role="alert">
            <h2 class="message__heading title">
                Kopieren nicht möglich
            </h2>
            <div class="message__body">
                {{ formError }}
            </div>
        </div>
    {% endif %}

    {% embed "block/scaffholding/board.twig" with {
        'class': 'board--spaceless config-view',
        'messages': 'hide'
    } %}
        {% from 'element/helper/form.twig' import providername %}
        
        {% block board_title %}
            Quellstandort auswählen
        {% endblock %}

        {% block board_body %}
            <form
                id="mailtemplates-copy-source-form"
                method="get"
                action="{{ urlGet('mailtemplatesCopy', {}, {}) }}"
                class="form--base"
            >
                <div class="formgroup">
                    <label
                        class="formgroup__label"
                        for="sourceScopeId"
                    >
                        Quellstandort
                    </label>

                    <select
                        id="sourceScopeId"
                        name="sourceScopeId"
                        required
                        aria-required="true"
                        aria-describedby="sourceScopeIdHelp"
                    >
                        <option value="">
                            Bitte auswählen
                        </option>

                        {% for scope in scopeList %}
                            <option
                                value="{{ scope.id }}"
                                {% if scope.id == sourceScopeId %}
                                    selected="selected"
                                {% endif %}
                            >
                                {{ providername(scope) }}
                            </option>
                        {% endfor %}
                    </select>

                    <p
                        id="sourceScopeIdHelp"
                        class="formgroup__help"
                    >
                        Nach der Auswahl eines Quellstandorts werden
                        dessen angepasste E-Mail-Templates automatisch
                        geladen.
                    </p>
                </div>

                <noscript>
                    <div class="form-actions">
                        <button
                            type="submit"
                            class="button button-submit"
                        >
                            Angepasste Templates anzeigen
                        </button>
                    </div>
                </noscript>
            </form>

            <script>
                (function () {
                    const sourceScopeSelect =
                        document.getElementById('sourceScopeId');

                    if (!sourceScopeSelect) {
                        return;
                    }

                    sourceScopeSelect.addEventListener(
                        'change',
                        function () {
                            if (sourceScopeSelect.value === '') {
                                return;
                            }

                            sourceScopeSelect.form.requestSubmit();
                        }
                    );
                }());
            </script>
        {% endblock %}
    {% endembed %}

    {% if selectedSourceScope %}
        {% embed "block/scaffholding/board.twig" with {
            'class': 'board--spaceless config-view',
            'messages': 'hide'
        } %}
            {% from 'element/helper/form.twig' import providername %}

            {% block board_title %}
                Template und Zielstandorte auswählen
            {% endblock %}

            {% block board_body %}
                {% set targetScopeOptions = [] %}

                {% for department in workstation.useraccount.departments %}
                    {% set departmentScopeOptions = [] %}

                    {% for scope in department.scopes %}
                        {% if
                            scope.id != selectedSourceScope.id
                            and scope.provider.id
                                != selectedSourceScope.provider.id
                        %}
                            {% set departmentScopeOptions =
                                departmentScopeOptions|merge([
                                    {
                                        'value': scope.id,
                                        'name': providername(scope)
                                    }
                                ])
                            %}
                        {% endif %}
                    {% endfor %}

                    {% for cluster in department.clusters %}
                        {% for scope in cluster.scopes %}
                            {% if
                                scope.id != selectedSourceScope.id
                                and scope.provider.id
                                    != selectedSourceScope.provider.id
                            %}
                                {% set departmentScopeOptions =
                                    departmentScopeOptions|merge([
                                        {
                                            'value': scope.id,
                                            'name': providername(scope)
                                        }
                                    ])
                                %}
                            {% endif %}
                        {% endfor %}
                    {% endfor %}

                    {% if departmentScopeOptions|length > 0 %}
                        {% set targetScopeOptions =
                            targetScopeOptions|merge([
                                {
                                    'name': department.name,
                                    'options':
                                        departmentScopeOptions|msort('name')
                                }
                            ])
                        %}
                    {% endif %}
                {% endfor %}

                {% if customTemplates|length > 0 %}
                    <form
                        method="post"
                        action="{{ urlGet(
                            'mailtemplatesCopy',
                            {},
                            {}
                        ) }}"
                        class="form--base"
                    >
                        <input
                            type="hidden"
                            name="sourceScopeId"
                            value="{{ selectedSourceScope.id }}"
                        >

                        <div class="formgroup">
                            <label
                                class="formgroup__label"
                                for="sourceTemplateId"
                            >
                                Angepasstes E-Mail-Template
                            </label>

                            <select
                                id="sourceTemplateId"
                                name="sourceTemplateId"
                                required
                            >
                                <option value="">
                                    Bitte auswählen
                                </option>

                                {% for template in customTemplates %}
                                    <option
                                        value="{{ template.id }}"
                                        {% if
                                            template.id
                                            == selectedSourceTemplateId
                                        %}
                                            selected="selected"
                                        {% endif %}
                                    >
                                        {{ template.name }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        <fieldset class="mailtemplates-copy-location-selector">
                            <div class="header">
                                <label for="targetScopeIds">
                                    Zielstandorte
                                </label>

                                <button
                                    type="button"
                                    id="select-all-target-scopes"
                                    class="btn-icon"
                                    aria-label="Alle auswählen"
                                    title="Alle Standorte auswählen"
                                >
                                    <i
                                        class="fas fa-check-double"
                                        aria-hidden="true"
                                    ></i>
                                </button>
                            </div>

                            <p
                                id="targetScopeIdsHelp"
                                class="formgroup__help"
                            >
                                Wählen Sie mindestens einen Zielstandort aus.
                                Halten Sie die Strg-Taste gedrückt, um einzelne
                                Standorte auszuwählen oder abzuwählen. Mit der
                                Shift-Taste können Sie einen zusammenhängenden
                                Bereich auswählen.<br>
                                Eine bereits vorhandene Anpassung desselben
                                Templates wird überschrieben.
                            </p>

                            <select
                                id="targetScopeIds"
                                name="targetScopeIds[]"
                                class="form-control"
                                multiple="multiple"
                                size="8"
                                required
                                aria-required="true"
                                aria-describedby="targetScopeIdsHelp"
                                style="width: 100%;"
                            >
                                {% for departmentGroup in targetScopeOptions %}
                                    <optgroup label="{{ departmentGroup.name }}">
                                        {% for scopeOption in departmentGroup.options %}
                                            <option
                                                value="{{ scopeOption.value }}"
                                                {% if
                                                    scopeOption.value
                                                    in selectedTargetScopeIds
                                                %}
                                                    selected="selected"
                                                {% endif %}
                                            >
                                                {{ scopeOption.name }}
                                            </option>
                                        {% endfor %}
                                    </optgroup>
                                {% endfor %}
                            </select>
                        </fieldset>

                        <script>
                            const selectAllTargetScopesButton =
                                document.getElementById(
                                    'select-all-target-scopes'
                                );

                            const targetScopeSelect =
                                document.getElementById('targetScopeIds');

                            if (
                                selectAllTargetScopesButton
                                && targetScopeSelect
                            ) {
                                selectAllTargetScopesButton.addEventListener(
                                    'click',
                                    function () {
                                        const options = Array.from(
                                            targetScopeSelect.options
                                        );

                                        const allSelected = options.every(
                                            function (option) {
                                                return option.selected;
                                            }
                                        );

                                        options.forEach(function (option) {
                                            option.selected = !allSelected;
                                        });
                                    }
                                );
                            }
                        </script>

                        <div class="form-actions">
                            <button
                                type="submit"
                                name="copy"
                                value="1"
                                class="button button--positive"
                            >
                                Template kopieren
                            </button>

                            <a
                                class="button"
                                href="{{ urlGet(
                                    'mailtemplatesScope',
                                    {
                                        'scopeId':
                                            selectedSourceScope.id
                                    },
                                    {}
                                ) }}"
                            >
                                Zurück zu den E-Mail-Templates
                            </a>
                        </div>
                    </form>
                {% else %}
                    <p>
                        Für den ausgewählten Standort sind keine
                        angepassten E-Mail-Templates vorhanden.
                    </p>

                    <div class="form-actions">
                        <a
                            class="button"
                            href="{{ urlGet(
                                'mailtemplatesScope',
                                {
                                    'scopeId':
                                        selectedSourceScope.id
                                },
                                {}
                            ) }}"
                        >
                            Zurück zu den E-Mail-Templates
                        </a>
                    </div>
                {% endif %}
            {% endblock %}
        {% endembed %}
    {% endif %}
{% endblock %}
