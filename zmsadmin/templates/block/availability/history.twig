{# Öffnungszeiten change history (tech admin only), loaded on page view. #}
{% if canViewAvailabilityHistory|default(false) %}
<section class="availability-history board board--spaceless" style="margin-top: 1.5rem;">
    <div class="board__header">
        <h2 class="board__heading heading"
            id="availability-history-heading"
            data-url="{{ includeUrl }}/scope/{{ scope.id }}/availability/history/">
            Änderungsverlauf
        </h2>
    </div>
    <div id="availability-history-panel" class="board__body body" aria-labelledby="availability-history-heading">
        <p class="availability-history-status" id="availability-history-status">Wird geladen…</p>
        <div class="table-responsive-wrapper" id="availability-history-table-wrap" hidden>
            <table class="table--base availability-history-table" id="availability-history-table">
                <thead>
                    <tr>
                        <th>Aktion</th>
                        <th>Wochentage</th>
                        <th>Serie</th>
                        <th>Von</th>
                        <th>Bis</th>
                        <th>Uhrzeit</th>
                        <th>Typ</th>
                        <th>Zeitschlitz</th>
                        <th>Arbeitsplätze</th>
                        <th>Buchung</th>
                        <th>Anmerkung</th>
                    </tr>
                </thead>
                <tbody id="availability-history-tbody"></tbody>
            </table>
        </div>
    </div>
</section>
<style>
    .availability-history-table .cell--meta {
        white-space: nowrap;
        color: #555;
        font-size: 0.9em;
        line-height: 1.35;
    }
</style>
<script>
(function () {
    var heading = document.getElementById('availability-history-heading');
    var statusEl = document.getElementById('availability-history-status');
    var wrapEl = document.getElementById('availability-history-table-wrap');
    var tbodyEl = document.getElementById('availability-history-tbody');
    if (!heading || !statusEl || !wrapEl || !tbodyEl) {
        return;
    }

    var actionLabels = {
        created: 'Erstellt',
        updated: 'Geändert',
        deleted: 'Gelöscht',
        dldb_slot_update: 'DLDB Slotlänge'
    };

    function formatChangedAt(value) {
        if (!value) {
            return '';
        }
        var normalized = String(value).replace(' ', 'T');
        var date = new Date(normalized);
        if (isNaN(date.getTime())) {
            return value;
        }
        var pad = function (n) { return n < 10 ? '0' + n : String(n); };
        return pad(date.getDate()) + '.' + pad(date.getMonth() + 1) + '.' + date.getFullYear()
            + ' ' + pad(date.getHours()) + ':' + pad(date.getMinutes());
    }

    var weekdayLabels = {
        monday: 'Montag',
        tuesday: 'Dienstag',
        wednesday: 'Mittwoch',
        thursday: 'Donnerstag',
        friday: 'Freitag',
        saturday: 'Samstag',
        sunday: 'Sonntag'
    };
    var weekdayOrder = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'];
    var seriesLabels = {
        '0': 'einmaliger Termin',
        '-1': 'jede Woche',
        '-2': 'alle 2 Wochen',
        '-3': 'alle 3 Wochen',
        '1': 'jede 1. Woche im Monat',
        '2': 'jede 2. Woche im Monat',
        '3': 'jede 3. Woche im Monat',
        '4': 'jede 4. Woche im Monat',
        '5': 'jede letzte Woche im Monat'
    };

    function formatWeekdays(weekday) {
        if (!weekday || typeof weekday !== 'object') {
            return '';
        }
        return weekdayOrder.filter(function (key) {
            return parseInt(weekday[key], 10) > 0;
        }).map(function (key) {
            return weekdayLabels[key];
        }).join(', ');
    }

    function isZeroTime(value) {
        if (!value) {
            return true;
        }
        var normalized = String(value).trim();
        return normalized === '00:00:00' || normalized === '00:00' || normalized === '0:00' || normalized === '0';
    }

    function pad(n) {
        return n < 10 ? '0' + n : String(n);
    }

    function formatDate(value) {
        if (!value) {
            return '';
        }
        var match = String(value).match(/^(\d{4})-(\d{2})-(\d{2})/);
        if (match) {
            return match[3] + '.' + match[2] + '.' + match[1];
        }
        return String(value);
    }

    function formatTime(value) {
        if (!value) {
            return '';
        }
        var match = String(value).match(/^(\d{1,2}):(\d{2})/);
        if (!match) {
            return '';
        }
        return pad(parseInt(match[1], 10)) + ':' + match[2];
    }

    function formatSeries(row) {
        var afterWeeks = parseInt(row.everyXWeeks, 10) || 0;
        var weekOfMonth = parseInt(row.everyOtherWeek, 10) || 0;
        var key = '0';
        if (afterWeeks > 0) {
            key = String(-afterWeeks);
        } else if (weekOfMonth > 0) {
            key = String(weekOfMonth);
        }
        return seriesLabels[key] || '';
    }

    function formatType(row) {
        return isZeroTime(row.appointmentStartTime) ? 'Spontankunden' : 'Terminkunden';
    }

    function formatTimeRange(row) {
        var useAppointment = !isZeroTime(row.appointmentStartTime);
        var startLabel = formatTime(useAppointment ? row.appointmentStartTime : row.startTime);
        var endLabel = formatTime(useAppointment ? row.appointmentEndTime : row.endTime);
        if (!startLabel && !endLabel) {
            return '';
        }
        return startLabel + ' - ' + endLabel;
    }

    function formatSlotTime(row) {
        var match = String(row.timeSlot || '').match(/^(\d{1,2}):(\d{2})/);
        if (!match) {
            return '';
        }
        return (parseInt(match[1], 10) * 60 + parseInt(match[2], 10)) + 'min';
    }

    function formatWorkstations(row) {
        var intern = parseInt(row.appointmentWorkstationCount, 10);
        if (isNaN(intern)) {
            return '';
        }
        var reduction = parseInt(row.internetReduction, 10) || 0;
        var publicCount = intern - reduction;
        if (publicCount < 0) {
            publicCount = 0;
        }
        return intern + '/' + publicCount;
    }

    function formatBookable(row) {
        if (row.openFromDays === null || row.openFromDays === undefined || row.openFromDays === '') {
            return '';
        }
        if (row.openUntilDays === null || row.openUntilDays === undefined || row.openUntilDays === '') {
            return '';
        }
        return row.openFromDays + '-' + row.openUntilDays;
    }

    function cell(text) {
        var td = document.createElement('td');
        td.textContent = text || '–';
        return td;
    }

    function renderRows(rows) {
        tbodyEl.innerHTML = '';
        if (!rows || !rows.length) {
            statusEl.textContent = 'Kein Änderungsverlauf im gewählten Zeitraum.';
            statusEl.hidden = false;
            wrapEl.hidden = true;
            return;
        }
        rows.forEach(function (row) {
            var tr = document.createElement('tr');
            var meta = document.createElement('td');
            meta.className = 'cell--meta';
            var actionEl = document.createElement('div');
            actionEl.textContent = actionLabels[row.action] || row.action;
            meta.appendChild(actionEl);
            var changedAtEl = document.createElement('div');
            changedAtEl.textContent = formatChangedAt(row.changedAt);
            meta.appendChild(changedAtEl);
            if (row.changedBy) {
                var changedByEl = document.createElement('div');
                changedByEl.textContent = row.changedBy;
                meta.appendChild(changedByEl);
            }
            tr.appendChild(meta);
            tr.appendChild(cell(formatWeekdays(row.weekday)));
            tr.appendChild(cell(formatSeries(row)));
            tr.appendChild(cell(formatDate(row.startDate)));
            tr.appendChild(cell(formatDate(row.endDate)));
            tr.appendChild(cell(formatTimeRange(row)));
            tr.appendChild(cell(formatType(row)));
            tr.appendChild(cell(formatSlotTime(row)));
            tr.appendChild(cell(formatWorkstations(row)));
            tr.appendChild(cell(formatBookable(row)));
            tr.appendChild(cell(row.comment));
            tbodyEl.appendChild(tr);
        });
        statusEl.hidden = true;
        wrapEl.hidden = false;
    }

    statusEl.hidden = false;
    statusEl.textContent = 'Wird geladen…';
    wrapEl.hidden = true;

    window.jQuery.ajax(heading.getAttribute('data-url'), {
        method: 'GET'
    }).done(function (payload) {
        renderRows(payload.data || []);
    }).fail(function () {
        statusEl.textContent = 'Änderungsverlauf konnte nicht geladen werden.';
        statusEl.hidden = false;
        wrapEl.hidden = true;
    });
})();
</script>
{% endif %}
