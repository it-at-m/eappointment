{% embed "block/scaffholding/board.twig" with {
    'class': 'client-confirm-call-other',
    'data': {
        'current-process-id': workstation.process.id,
        'current-status': workstation.process.status,
        'selected-process-id': selectedProcess.id
    }
} %}
        {% block board_title %}
            <span class="color-blue"><i class="fas fa-info-circle" aria-hidden="true"></i></span>
            {% trans %}Kunde in Bearbeitung{% endtrans %}
        {% endblock %}
        {% block board_body %}
            <p>
                {% trans %}Es befindet sich bereits ein Kunde in Bearbeitung. Möchten Sie den aktuellen Termin beenden und den ausgewählten Kunden aufrufen?{% endtrans %}
            </p>
            <dl>
                <dt>{% trans %}Aktueller Vorgang{% endtrans %}</dt>
                <dd>
                    {{ workstation.process.clients|first.familyName }}
                    <br>(Wartenr. {{ workstation.process.displayNumber }})
                </dd>
                <dt>{% trans %}Ausgewählter Kunde{% endtrans %}</dt>
                <dd>
                    {{ selectedProcess.clients|first.familyName|default('Wartenummer') }}
                    <br>(Wartenr. {{ selectedProcess.displayNumber }})
                </dd>
            </dl>
            <button
                type="button"
                class="button button--default button--fullwidth client-confirm-call-other_stay"
                style="margin: 0.5em 0;"
            >{% trans %}Zurück zum aktuellen Vorgang{% endtrans %}</button>
            <a
                class="button button--positive button--fullwidth client-confirm-call-other_switch"
                href="{{ urlGet('workstationProcessFinished', {}, {'nextprocess': selectedProcess.id}) }}"
                style="margin: 0.5em 0;"
            >{% trans %}Aktuellen Termin abschließen und Kunden aufrufen{% endtrans %}</a>
        {% endblock %}

        {% block board_footer %}
        {% include "block/process/footer.twig" %}
        {% endblock %}

{% endembed %}
