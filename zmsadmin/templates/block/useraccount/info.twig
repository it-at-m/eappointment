{% embed "block/scaffholding/board.twig" with {'class': 'useraccount-info', 'messages':'hide'} %}
    {% block board_title %}
        Nutzerinformation
    {% endblock %} 

    {% block board_body %}
    
        <h3>Benutzername</h3>
        <p>{{ profile.username }}</p>

        <h3>Rolle</h3>
        <p>{{ profile.role }}</p>

        <h3>Berechtigungen</h3>
        <ul>
            {% for permission in profile.permissions %}
                <li>{{ permission }}</li>
            {% else %}
                <li>Keine Berechtigungen zugeordnet</li>
            {% endfor %}
        </ul>
    {% endblock %}
{% endembed %}
