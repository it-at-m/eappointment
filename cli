#!/usr/bin/env python3
"""Thin entrypoint: core CLI (DB/modules), local appointment tools, local cron, and ATAF tests."""

import os
import sys

import click
from colorama import init as colorama_init

from cli_appointments import AppointmentsCli
from cli_base import EappointmentCli
from cli_cron import CronCli
from cli_test import TestCli

colorama_init()


@click.group()
def cli():
  """zmslocaldev helper: modules, database, appointments, cron, clean, tests."""
  pass


def main():
  repo_dir = os.path.dirname(os.path.abspath(sys.argv[0]))
  EappointmentCli(repo_dir).register(cli)
  AppointmentsCli(repo_dir).register_appointments(cli)
  CronCli(repo_dir).register_cron(cli)
  TestCli(repo_dir).register_tests(cli)
  cli()


if __name__ == "__main__":
  main()
