#!/usr/bin/env python3
"""
Book every remaining opening-hour seat at every scope (via zmsapi).

Walks all scopes (or BOOK_SCOPE_IDS), and for each day from today through
the scope's bookable end (preferences.appointment.endInDaysDefault, max 180)
reserves and confirms free seats until the free list is empty.

Public and intern are separate capacities that share one occupancy count.
Both are filled, public first, so citizen and staff calendars are full.
Each scope is filled for every service that still has seats, so opening
hours that only apply to some services are covered too. Appointment size
is about 83% single, 10% with one extra service, then a thin tail.
A larger size is used only when those services are combinable on the scope.

Slots already booked are skipped on a re-run. Names start with LOADTEST-.

Local only. The CLI logs in as _system_queuefill.
"""

from __future__ import annotations

import argparse
import json
import os
import random
import ssl
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from concurrent.futures import ThreadPoolExecutor, as_completed
from datetime import date, datetime, timedelta, timezone
from typing import Any

try:
    from zoneinfo import ZoneInfo

    BERLIN_TIMEZONE = ZoneInfo("Europe/Berlin")
except Exception:  # pragma: no cover - minimal images without tzdata
    BERLIN_TIMEZONE = timezone(timedelta(hours=1))


# Slot calculation in zmsbackend stops at 180 days (Slot::MAX_DAYS_OF_SLOT_CALCULATION).
MAX_DAY_OFFSET = 180
DEFAULT_END_IN_DAYS = 60
PAUSE_BETWEEN_REQUESTS_SECONDS = 0.02
HTTP_TIMEOUT_SECONDS = 120
LOADTEST_CUSTOMER_EMAIL = "test@muenchen.de"
# Real API failures (not a stale slot, and not a retried overload) before a day is abandoned.
MAX_CONSECUTIVE_ERRORS = 8
# In-flight scope-days. Empty BOOK_WORKERS uses the default. Never unbounded:
# one thread per scope per day exhausted the database (HTTP 503, broken pipe).
DEFAULT_WORKERS = 16
MAX_WORKERS = 32
TRANSIENT_HTTP_STATUSES = frozenset({429, 502, 503})
TRANSIENT_ATTEMPTS = 5
# Deadlock / lock-wait on confirm often comes back as 500. Retry a few times
# without pausing the other workers.
SERVER_ERROR_ATTEMPTS = 3
SLOT_TYPES = ("public", "intern")
# Appointment size mix: single, then one extra service, then a thin tail.
# The filler rolls this, then shrinks to what the scope can combine.
SERVICE_COUNT_WEIGHTS = (
    (1, 83),
    (2, 10),
    (3, 4),
    (4, 2),
    (5, 1),
)

LOCAL_API_HOSTS = frozenset({"127.0.0.1", "localhost", "web"})


class ZmsApiError(RuntimeError):
    """HTTP or logical failure talking to zmsapi."""

    def __init__(self, message: str, status_code: int = 0, response_body: str = ""):
        super().__init__(message)
        self.status_code = status_code
        self.response_body = response_body


class ProgressLine:
    """One redrawn line on a terminal. Other logs print above it."""

    def __init__(self) -> None:
        self._lock = threading.Lock()
        self._line = ""
        self.tty = sys.stdout.isatty()

    def show(self, line: str) -> None:
        with self._lock:
            self._line = line
            if self.tty:
                print("\r\033[K" + line, end="", flush=True)

    def println(self, message: str) -> None:
        with self._lock:
            if self.tty and self._line:
                print("\r\033[K" + message, flush=True)
                print("\r\033[K" + self._line, end="", flush=True)
            else:
                print(message, flush=True)

    def close(self) -> None:
        with self._lock:
            if self.tty and self._line:
                print(flush=True)
                self._line = ""


PROGRESS = ProgressLine()


def print_log(message: str) -> None:
    PROGRESS.println(message)


def http_failure_message(method: str, path: str, status_code: int, raw: str) -> str:
    """Include the API exception class and message. HTTP 500 bodies carry both."""
    message = f"{method} {path} -> HTTP {status_code}"
    detail = ""
    try:
        payload = json.loads(raw) if raw else None
    except json.JSONDecodeError:
        payload = None
    meta = payload.get("meta") if isinstance(payload, dict) else None
    if isinstance(meta, dict):
        exception_name = str(meta.get("exception") or "").rsplit("\\", 1)[-1]
        exception_message = str(meta.get("message") or "").strip()
        detail = ": ".join(part for part in (exception_name, exception_message) if part)
    if not detail and raw:
        detail = raw.replace("\n", " ")[:180]
    if detail:
        message = f"{message}: {detail[:300]}"
    return message


def interleave_by_scope(jobs: list[Any], scope_index: int = 0) -> list[Any]:
    """Round-robin so workers start on different scopes instead of one scope's days."""
    buckets: dict[int, list[Any]] = {}
    order: list[int] = []
    for job in jobs:
        scope_id = int(job[scope_index])
        bucket = buckets.get(scope_id)
        if bucket is None:
            bucket = []
            buckets[scope_id] = bucket
            order.append(scope_id)
        bucket.append(job)
    interleaved: list[Any] = []
    index = 0
    while True:
        added = False
        for scope_id in order:
            bucket = buckets[scope_id]
            if index < len(bucket):
                interleaved.append(bucket[index])
                added = True
        if not added:
            return interleaved
        index += 1


class OverloadBrake:
    """Shared pause so an HTTP 503 storm waits instead of hammering the database."""

    def __init__(self) -> None:
        self._lock = threading.Lock()
        self._until = 0.0
        self._step = 0

    def before_request(self) -> None:
        with self._lock:
            delay = self._until - time.monotonic()
        if delay > 0:
            time.sleep(delay)

    def note_overload(self) -> float | None:
        with self._lock:
            now = time.monotonic()
            if self._until > now:
                self._until = max(self._until, now + 1.0)
                return None
            self._step = min(self._step + 1, 6)
            pause = min(20.0, 0.5 * (2 ** (self._step - 1)))
            self._until = now + pause
            return pause

    def note_ok(self) -> None:
        with self._lock:
            if time.monotonic() >= self._until:
                self._step = 0


def environment_flag(name: str) -> bool:
    return os.environ.get(name, "").lower() in {"1", "true", "yes"}


def environment_float(name: str, default: float) -> float:
    raw = os.environ.get(name, "").strip()
    if not raw:
        return default
    return float(raw)


def environment_int(name: str, default: int) -> int:
    raw = os.environ.get(name, "").strip()
    if not raw:
        return default
    return int(raw)


def optional_int(name: str) -> int | None:
    raw = os.environ.get(name, "").strip()
    if not raw:
        return None
    return int(raw)


def refuse_if_not_local(base_url: str, environment: str) -> None:
    env = (environment or "").strip().lower()
    if env in {"prod", "production"}:
        raise SystemExit("Refusing to run when ENVIRONMENT is prod")
    host = urllib.parse.urlparse(base_url).hostname or ""
    if host not in LOCAL_API_HOSTS:
        raise SystemExit("Refusing a non-local API URL")


def parse_scope_id_list(value: str) -> list[int] | None:
    """Comma-separated scope ids. Empty means every scope."""
    parts = [part.strip() for part in (value or "").split(",") if part.strip()]
    if not parts:
        return None
    ids: list[int] = []
    for part in parts:
        scope_id = int(part)
        if scope_id <= 0:
            raise SystemExit(f"scope id must be positive, got {part}")
        ids.append(scope_id)
    return ids


def bookable_end_offset(scope: dict[str, Any], days_override: int | None) -> int:
    """
    Last day to fill, as an offset from today.

    Override wins. Otherwise preferences.appointment.endInDaysDefault
    (schema default 60). Capped at MAX_DAY_OFFSET.
    """
    if days_override is not None:
        offset = days_override
    else:
        preferences = scope.get("preferences") or {}
        appointment = {}
        if isinstance(preferences, dict):
            appointment = preferences.get("appointment") or {}
        raw = appointment.get("endInDaysDefault") if isinstance(appointment, dict) else None
        try:
            offset = int(raw) if raw is not None and str(raw).strip() != "" else DEFAULT_END_IN_DAYS
        except (TypeError, ValueError):
            offset = DEFAULT_END_IN_DAYS
    if offset < 0:
        offset = 0
    return min(offset, MAX_DAY_OFFSET)


def days_to_fill(start: date, today: date, end_offset: int) -> list[date]:
    """Inclusive dates from start through today+end_offset. Past days are dropped."""
    end = today + timedelta(days=end_offset)
    if start > end:
        return []
    cursor = start
    days: list[date] = []
    while cursor <= end:
        if cursor >= today:
            days.append(cursor)
        cursor += timedelta(days=1)
    return days


def scope_label(scope: dict[str, Any]) -> str:
    for key in ("shortName", "name"):
        if scope.get(key):
            return str(scope[key])
    contact = scope.get("contact")
    if isinstance(contact, dict) and contact.get("name"):
        return str(contact["name"])
    return str(scope.get("id") or "")


def as_entity_list(data: Any) -> list[dict[str, Any]]:
    if isinstance(data, list):
        return [item for item in data if isinstance(item, dict)]
    if isinstance(data, dict):
        if "id" in data:
            return [data]
        return [item for item in data.values() if isinstance(item, dict)]
    return []


def appointment_start_epoch(process: dict[str, Any]) -> int:
    """Unix epoch of the first appointment. 0 if the payload has no usable time."""
    appointments = process.get("appointments") or [{}]
    raw = (appointments[0] or {}).get("date") if appointments else None
    if raw is None or raw == "":
        return 0
    if isinstance(raw, dict):
        try:
            stamp = datetime(
                int(raw["year"]),
                int(raw["month"]),
                int(raw["day"]),
                int(raw.get("hour") or 0),
                int(raw.get("minute") or 0),
                tzinfo=BERLIN_TIMEZONE,
            )
            return int(stamp.timestamp())
        except (KeyError, TypeError, ValueError):
            return 0
    if isinstance(raw, (int, float)):
        return int(raw)
    text = str(raw).strip()
    if text.isdigit():
        return int(text)
    for fmt in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%d %H:%M"):
        try:
            stamp = datetime.strptime(text, fmt).replace(tzinfo=BERLIN_TIMEZONE)
            return int(stamp.timestamp())
        except ValueError:
            continue
    return 0


def is_bookable_slot(process: dict[str, Any], earliest_epoch: int, day_end_epoch: int) -> bool:
    epoch = appointment_start_epoch(process)
    if epoch <= 0:
        return True
    return earliest_epoch <= epoch <= day_end_epoch


class BerlinTime:
    """Europe/Berlin clock, same zone ZMS uses for slots."""

    @staticmethod
    def now() -> datetime:
        return datetime.now(BERLIN_TIMEZONE)

    @classmethod
    def parse_day(cls, value: str) -> date:
        if not value or value.lower() == "today":
            return cls.now().date()
        return date.fromisoformat(value)

    @staticmethod
    def start_of_day(day: date) -> datetime:
        return datetime(day.year, day.month, day.day, tzinfo=BERLIN_TIMEZONE)

    @classmethod
    def earliest_bookable_epoch(cls, day: date) -> int:
        """First bookable unix time on that day (never before now on today)."""
        now = cls.now()
        if day < now.date():
            raise SystemExit(f"Refusing day {day}: it is in the past")
        if day > now.date():
            return int(cls.start_of_day(day).timestamp())
        epoch = int(now.timestamp())
        current_minute = epoch - (epoch % 60)
        if epoch % 60 <= 40:
            return current_minute
        return current_minute + 60

    @classmethod
    def end_of_day_epoch(cls, day: date) -> int:
        return int((cls.start_of_day(day) + timedelta(days=1)).timestamp())


class ZmsApiClient:
    """Login, scope list, free seats, reserve + confirm."""

    def __init__(self, base_url: str, verify_tls: bool = True):
        self.base_url = base_url.rstrip("/") + "/"
        self.auth_key: str | None = None
        self._brake = OverloadBrake()
        self._ssl_context = ssl.create_default_context()
        if not verify_tls:
            self._ssl_context.check_hostname = False
            self._ssl_context.verify_mode = ssl.CERT_NONE

    def _extract_data(self, payload: Any) -> Any:
        if isinstance(payload, dict):
            return payload.get("data")
        return None

    def _request(
        self,
        method: str,
        path: str,
        body: Any = None,
        query: dict[str, Any] | None = None,
        use_auth: bool = True,
    ) -> tuple[int, Any]:
        url = urllib.parse.urljoin(self.base_url, path.lstrip("/"))
        if query:
            separator = "&" if "?" in url else "?"
            filtered = {key: value for key, value in query.items() if value is not None}
            url += separator + urllib.parse.urlencode(filtered)

        raw_body = None
        headers = {"Accept": "application/json"}
        if body is not None:
            raw_body = json.dumps(body).encode("utf-8")
            headers["Content-Type"] = "application/json"
        if use_auth:
            if not self.auth_key:
                raise ZmsApiError("Not logged in")
            headers["X-AuthKey"] = self.auth_key

        request = urllib.request.Request(url, data=raw_body, headers=headers, method=method)
        for attempt in range(1, TRANSIENT_ATTEMPTS + 1):
            self._brake.before_request()
            try:
                with urllib.request.urlopen(
                    request, context=self._ssl_context, timeout=HTTP_TIMEOUT_SECONDS
                ) as response:
                    raw = response.read().decode("utf-8", errors="replace")
                    status_code = response.getcode()
            except urllib.error.HTTPError as error:
                raw = ""
                try:
                    raw = error.read().decode("utf-8", errors="replace")
                except OSError:
                    raw = ""
                if error.code in TRANSIENT_HTTP_STATUSES and attempt < TRANSIENT_ATTEMPTS:
                    self._log_backoff(method, path, f"HTTP {error.code}")
                    continue
                if error.code == 500 and attempt < SERVER_ERROR_ATTEMPTS:
                    time.sleep(0.5 * attempt)
                    continue
                raise ZmsApiError(
                    http_failure_message(method, path, error.code, raw),
                    status_code=error.code,
                    response_body=raw[:2000],
                ) from error
            except (urllib.error.URLError, TimeoutError, OSError) as error:
                if attempt < TRANSIENT_ATTEMPTS:
                    self._log_backoff(method, path, str(error))
                    continue
                raise ZmsApiError(f"{method} {path} failed: {error}") from error

            self._brake.note_ok()
            try:
                parsed = json.loads(raw) if raw else None
            except json.JSONDecodeError:
                parsed = raw
            return status_code, parsed
        raise ZmsApiError(f"{method} {path} failed after {TRANSIENT_ATTEMPTS} attempts")

    def _log_backoff(self, method: str, path: str, reason: str) -> None:
        pause = self._brake.note_overload()
        if pause is not None:
            print_log(f"database busy ({reason} {method} {path}), pausing {pause:.0f}s")

    def _require_http_ok(self, status_code: int, payload: Any, message: str) -> Any:
        if status_code != 200:
            raise ZmsApiError(message, status_code=status_code, response_body=str(payload)[:1000])
        return self._extract_data(payload)

    def login_with_password(self, username: str, password: str) -> None:
        login_name = username.strip()
        status_code, payload = self._request(
            "POST",
            "/workstation/login/",
            body={"id": login_name, "password": password, "departments": [{"id": 0}]},
            use_auth=False,
        )
        if status_code < 200 or status_code >= 300:
            raise ZmsApiError(
                f"login as {login_name!r} failed HTTP {status_code}",
                status_code=status_code,
                response_body=str(payload)[:1000],
            )
        workstation = self._extract_data(payload) or {}
        auth_key = workstation.get("authkey") or workstation.get("authKey")
        if not auth_key:
            raise ZmsApiError("login ok but no authkey in response", response_body=str(payload)[:1000])
        self.auth_key = auth_key
        print_log(f"Logged in as {login_name}")

    def spawn(self) -> ZmsApiClient:
        """Another client on the same login. Safe to use from one worker thread."""
        client = ZmsApiClient.__new__(ZmsApiClient)
        client.base_url = self.base_url
        client.auth_key = self.auth_key
        client._brake = self._brake
        client._ssl_context = self._ssl_context
        return client

    def list_scopes(self) -> list[dict[str, Any]]:
        status_code, payload = self._request("GET", "/scope/", query={"resolveReferences": 1})
        data = self._require_http_ok(status_code, payload, f"GET /scope/ -> {status_code}")
        scopes = as_entity_list(data)
        if not scopes:
            raise ZmsApiError("no scopes returned", response_body=str(payload)[:1000])
        return scopes

    def list_scope_requests(self, scope_id: int) -> list[dict[str, Any]]:
        # resolveReferences=1 includes request.data, where DLDB stores combinable.
        # Without it the service list has no partners and every booking stays single.
        status_code, payload = self._request(
            "GET",
            f"/scope/{scope_id}/request/",
            query={"resolveReferences": 1},
        )
        data = self._require_http_ok(
            status_code, payload, f"GET /scope/{scope_id}/request/ -> {status_code}"
        )
        return as_entity_list(data)

    def list_free_slots(
        self,
        scope_id: int,
        service_requests: list[dict[str, Any]],
        day: date,
        earliest_epoch: int,
        slot_type: str,
    ) -> list[dict[str, Any]]:
        calendar = {
            "firstDay": {"year": day.year, "month": day.month, "day": day.day},
            "lastDay": {"year": day.year, "month": day.month, "day": day.day},
            "scopes": [{"id": scope_id}],
            "requests": list(service_requests),
        }
        status_code, payload = self._request(
            "POST",
            "/process/status/free/",
            body=calendar,
            query={"slotType": slot_type, "slotsRequired": 0},
        )
        free_list = self._require_http_ok(
            status_code,
            payload,
            f"POST /process/status/free/ scope={scope_id} -> {status_code}",
        )
        if not isinstance(free_list, list):
            free_list = as_entity_list(free_list)
        day_end = BerlinTime.end_of_day_epoch(day)
        slots = [
            process
            for process in free_list
            if isinstance(process, dict) and is_bookable_slot(process, earliest_epoch, day_end)
        ]
        slots.sort(key=appointment_start_epoch)
        return slots

    def reserve_and_confirm(
        self,
        service_requests: list[dict[str, Any]],
        free_slot_process: dict[str, Any],
        family_name: str,
        slot_type: str,
    ) -> str:
        """
        Reserve + confirm one appointment.

        service_requests is one service, or a DLDB combinable bundle. The API
        turns slotsRequired=0 into the sum of those services' slot counts.

        Returns "booked" or "stale" (slot gone or overlapping a seat just taken).
        """
        process = dict(free_slot_process)
        process["requests"] = list(service_requests)
        process["clients"] = [
            {
                "familyName": family_name,
                "email": LOADTEST_CUSTOMER_EMAIL,
                "surveyAccepted": 1,
            }
        ]
        try:
            status_code, payload = self._request(
                "POST",
                "/process/status/reserved/",
                body=process,
                query={"slotType": slot_type, "clientkey": "", "slotsRequired": 0},
            )
        except ZmsApiError as error:
            if error.status_code in {404, 409}:
                return "stale"
            raise
        if status_code == 404:
            return "stale"
        reserved = self._require_http_ok(status_code, payload, f"reserve -> {status_code}")
        if not reserved:
            return "stale"
        try:
            status_code, payload = self._request("POST", "/process/status/confirmed/", body=reserved)
        except ZmsApiError as error:
            if error.status_code in {404, 409}:
                return "stale"
            raise
        self._require_http_ok(status_code, payload, f"confirm -> {status_code}")
        return "booked"


def request_id(request: dict[str, Any]) -> str:
    value = request.get("id")
    return "" if value is None else str(value)


def request_data_object(request: dict[str, Any]) -> dict[str, Any]:
    data = request.get("data")
    if isinstance(data, dict):
        return data
    if isinstance(data, str) and data.strip():
        try:
            parsed = json.loads(data)
        except json.JSONDecodeError:
            return {}
        if isinstance(parsed, dict):
            return parsed
    return {}


def request_combinable_ids(request: dict[str, Any]) -> set[str]:
    """DLDB data.combinable service ids. Self-references are kept for the caller to drop."""
    data = request_data_object(request)
    raw = data.get("combinable") or []
    if not isinstance(raw, list):
        return set()
    ids: set[str] = set()
    for entry in raw:
        if isinstance(entry, dict):
            entry = entry.get("id")
        if entry is not None and str(entry) != "":
            ids.add(str(entry))
    return ids


def service_label(service_requests: list[dict[str, Any]]) -> str:
    return " + ".join(
        str(request.get("name") or request_id(request)) for request in service_requests
    )


def combinable_graph(
    requests: list[dict[str, Any]],
) -> tuple[dict[str, dict[str, Any]], dict[str, set[str]]]:
    """Service id -> request, and undirected DLDB combinable edges on this scope."""
    by_id = {request_id(request): request for request in requests if request_id(request)}
    neighbors: dict[str, set[str]] = {rid: set() for rid in by_id}
    for rid, request in by_id.items():
        for other in request_combinable_ids(request):
            if other != rid and other in by_id:
                neighbors[rid].add(other)
                neighbors[other].add(rid)
    return by_id, neighbors


def largest_clique(seed: str, neighbors: dict[str, set[str]], limit: int = 12) -> list[str]:
    """Largest mutual combinable set that contains seed, capped at limit."""
    bundle = [seed]
    candidates = set(neighbors.get(seed, ()))
    while len(bundle) < limit and candidates:
        connected = [
            candidate
            for candidate in candidates
            if all(candidate in neighbors[have] for have in bundle)
        ]
        if not connected:
            break
        nxt = max(connected, key=lambda rid: (len(neighbors[rid] & set(bundle)), rid))
        bundle.append(nxt)
        candidates &= neighbors[nxt]
        candidates.discard(nxt)
    return bundle


def roll_service_count(rng: random.Random, max_size: int) -> int:
    """Prod mix, restricted to sizes this service can actually combine."""
    eligible = [(size, weight) for size, weight in SERVICE_COUNT_WEIGHTS if size <= max_size]
    if not eligible:
        return 1
    sizes = [size for size, _weight in eligible]
    weights = [weight for _size, weight in eligible]
    return rng.choices(sizes, weights=weights, k=1)[0]


def bundle_of_size(
    seed: str,
    by_id: dict[str, dict[str, Any]],
    neighbors: dict[str, set[str]],
    size: int,
    rng: random.Random,
) -> list[dict[str, Any]]:
    clique = largest_clique(seed, neighbors, limit=max(size, 1))
    chosen = [seed]
    others = [rid for rid in clique if rid != seed]
    take = min(size - 1, len(others))
    if take > 0:
        chosen.extend(rng.sample(others, take))
    return [by_id[rid] for rid in chosen]


def select_requests(
    scope_requests: list[dict[str, Any]], service_name: str | None
) -> list[dict[str, Any]]:
    """All bookable services, or the one named service (exact, else substring)."""
    if not service_name:
        return list(scope_requests)
    needle = service_name.lower()
    exact = [
        request
        for request in scope_requests
        if str(request.get("name", "")).lower() == needle
    ]
    if exact:
        return exact[:1]
    partial = sorted(
        (
            request
            for request in scope_requests
            if needle in str(request.get("name", "")).lower()
        ),
        key=lambda request: len(str(request.get("name", ""))),
    )
    return partial[:1]


class OpeningHoursJob:
    """Login, then fill every selected scope until no free seats remain."""

    def __init__(self, args: argparse.Namespace):
        self.args = args
        self.report: dict[str, Any] = {}
        self._sequence = 0
        self._lock = threading.RLock()
        self._scope_locks: dict[int, threading.Lock] = {}
        self._rng = random.Random()
        self._service_counts: dict[int, int] = {}
        self._days_total = 0
        self._days_done = 0

    def run(self) -> int:
        self._validate()
        refuse_if_not_local(self.args.base_url, self.args.environment)

        today = BerlinTime.now().date()
        start = BerlinTime.parse_day(self.args.from_day)
        if start < today:
            raise SystemExit(f"Refusing --from {start}: it is in the past")

        only_ids = parse_scope_id_list(self.args.scope_ids or "")
        print_log(
            "Fill opening hours: "
            f"from={start} days_override={self.args.days} "
            f"scopes={only_ids or 'ALL'} dry_run={self.args.dry_run} "
            f"max_bookings={self.args.max_bookings or 'none'}"
        )
        print_log(
            "This books every remaining public and intern seat in opening hours. "
            "A re-run continues where free seats are left."
        )

        api = ZmsApiClient(self.args.base_url, verify_tls=not self.args.insecure)
        api.login_with_password(self.args.username, self.args.password)
        scopes = api.list_scopes()
        if only_ids is not None:
            wanted = set(only_ids)
            scopes = [scope for scope in scopes if int(scope.get("id") or 0) in wanted]
            found = {int(scope.get("id") or 0) for scope in scopes}
            missing = [scope_id for scope_id in only_ids if scope_id not in found]
            if missing:
                print_log(f"WARNING: scope ids not in GET /scope/: {missing}")
            if not scopes:
                raise SystemExit(f"None of the requested scopes exist: {only_ids}")

        self.report = {
            "base_url": self.args.base_url,
            "environment": self.args.environment,
            "dry_run": self.args.dry_run,
            "from_day": str(start),
            "days_override": self.args.days,
            "slot_types": list(SLOT_TYPES),
            "service_name": self.args.service_name,
            "scope_ids_filter": only_ids,
            "scopes_seen": len(scopes),
            "stopped_early": False,
            "scopes": [],
            "totals": {
                "booked": 0,
                "stale": 0,
                "skipped_scopes": 0,
                "errors": 0,
            },
        }
        self._write_report()
        self._run_scopes(api, scopes, today, start)
        PROGRESS.close()
        self._write_report()
        print_log(f"Wrote report {self.args.report}")
        print_log(json.dumps(self.report["totals"], indent=2))
        totals = self.report["totals"]
        if totals["errors"] and totals["booked"] == 0 and not self.args.dry_run:
            return 1
        return 0

    def _run_scopes(
        self,
        api: ZmsApiClient,
        scopes: list[dict[str, Any]],
        today: date,
        start: date,
    ) -> None:
        workers = self._worker_count(len(scopes))
        print_log(f"Preparing {len(scopes)} scopes with {workers} workers")
        prepared: list[tuple[int, dict[str, Any], list[dict[str, Any]], list[date]]] = []
        prepare_lock = threading.Lock()

        def prepare(scope: dict[str, Any]) -> None:
            try:
                item = self._prepare_scope(api.spawn(), scope, today, start)
            except Exception as error:
                print_log(f"ERROR scope {scope.get('id')}: {error}")
                return
            if item is not None:
                with prepare_lock:
                    prepared.append(item)

        self._run_pool(workers, scopes, prepare)

        jobs: list[tuple[int, dict[str, Any], list[dict[str, Any]], date]] = []
        remaining: dict[int, int] = {}
        for scope_id, entry, requests, days in prepared:
            key = id(entry)
            remaining[key] = len(days)
            for day in days:
                jobs.append((scope_id, entry, requests, day))

        if not jobs:
            return

        jobs = interleave_by_scope(jobs)
        workers = self._worker_count(len(jobs))
        self._days_total = len(jobs)
        self._days_done = 0
        self._show_progress()
        print_log(
            f"Booking {len(jobs)} scope-days with {workers} workers "
            f"(one day per scope at a time)"
        )

        def run_day(job: tuple[int, dict[str, Any], list[dict[str, Any]], date]) -> None:
            scope_id, entry, requests, day = job
            try:
                if self._budget_reached():
                    with self._lock:
                        self.report["stopped_early"] = True
                    return
                with self._lock_for_scope(scope_id):
                    if self._budget_reached():
                        with self._lock:
                            self.report["stopped_early"] = True
                        return
                    try:
                        booked, stale, consecutive_errors = self._fill_day(
                            api.spawn(), scope_id, requests, day, entry, 0
                        )
                    except Exception as error:
                        print_log(f"ERROR scope {scope_id} {day}: {error}")
                        return
                    if consecutive_errors >= MAX_CONSECUTIVE_ERRORS:
                        print_log(
                            f"scope {scope_id} {day}: stopped after "
                            f"{MAX_CONSECUTIVE_ERRORS} consecutive errors"
                        )
                        with self._lock:
                            self.report["stopped_early"] = True
                    if booked or stale:
                        print_log(
                            f"scope {scope_id} {day}: booked={booked} stale={stale} "
                            f"scope_total={entry['booked']}"
                        )
            finally:
                self._finish_day(id(entry), entry, remaining)

        self._run_pool(workers, jobs, run_day)

    def _run_pool(self, workers: int, items: list[Any], fn: Any) -> None:
        if not items:
            return
        if workers <= 1 or len(items) == 1:
            for item in items:
                fn(item)
            return
        with ThreadPoolExecutor(max_workers=workers) as pool:
            futures = [pool.submit(fn, item) for item in items]
            for future in as_completed(futures):
                future.result()

    def _finish_day(
        self, key: int, entry: dict[str, Any], remaining: dict[int, int]
    ) -> None:
        with self._lock:
            left = remaining.get(key, 1) - 1
            remaining[key] = left
            done = left <= 0
            self._days_done += 1
            line = self._progress_line_unlocked()
        PROGRESS.show(line)
        if done:
            self._finish_scope(entry, skipped=False)

    def _lock_for_scope(self, scope_id: int) -> threading.Lock:
        with self._lock:
            lock = self._scope_locks.get(scope_id)
            if lock is None:
                lock = threading.Lock()
                self._scope_locks[scope_id] = lock
            return lock

    def _worker_count(self, job_count: int) -> int:
        """Empty/0 means DEFAULT_WORKERS, never one thread per scope-day."""
        if job_count <= 0:
            return 1
        requested = self.args.workers if self.args.workers > 0 else DEFAULT_WORKERS
        if requested > MAX_WORKERS:
            print_log(f"workers {requested} capped at {MAX_WORKERS}")
            requested = MAX_WORKERS
        return min(requested, job_count)

    def _budget_reached(self) -> bool:
        limit = self.args.max_bookings
        if not limit or limit <= 0:
            return False
        with self._lock:
            return self.report["totals"]["booked"] >= limit

    def _next_family_name(self, scope_id: int) -> str:
        with self._lock:
            self._sequence += 1
            sequence = self._sequence
        return f"{self.args.name_prefix}-F-{scope_id}-{sequence:06d}"

    def _prepare_scope(
        self,
        api: ZmsApiClient,
        scope: dict[str, Any],
        today: date,
        start: date,
    ) -> tuple[int, dict[str, Any], list[dict[str, Any]], list[date]] | None:
        scope_id = int(scope.get("id") or 0)
        label = scope_label(scope)
        entry: dict[str, Any] = {
            "scope_id": scope_id,
            "name": label,
            "days": 0,
            "booked": 0,
            "stale": 0,
            "errors": [],
        }
        if scope_id <= 0:
            entry["errors"].append("missing scope id")
            self._finish_scope(entry, skipped=True)
            return None

        try:
            requests = api.list_scope_requests(scope_id)
        except ZmsApiError as error:
            print_log(f"scope {scope_id} ({label}): no requests ({error})")
            entry["errors"].append(f"requests: {error}")
            self._finish_scope(entry, skipped=True)
            return None

        requests = select_requests(requests, self.args.service_name)
        if not requests:
            print_log(f"scope {scope_id} ({label}): no matching service, skip")
            self._finish_scope(entry, skipped=True)
            return None

        end_offset = bookable_end_offset(scope, self.args.days)
        days = days_to_fill(start, today, end_offset)
        entry["days"] = len(days)
        entry["end_offset"] = end_offset
        if not days:
            print_log(f"scope {scope_id} ({label}): no days in window, skip")
            self._finish_scope(entry, skipped=True)
            return None

        _by_id, neighbors = combinable_graph(requests)
        partnered = sum(1 for peers in neighbors.values() if peers)
        entry["combinable_services"] = partnered
        print_log(
            f"=== scope {scope_id} ({label}): days={len(days)} queued "
            f"through +{end_offset} services={len(requests)} "
            f"combinable={partnered} dry_run={self.args.dry_run}"
        )
        return scope_id, entry, requests, days

    def _fill_day(
        self,
        api: ZmsApiClient,
        scope_id: int,
        requests: list[dict[str, Any]],
        day: date,
        entry: dict[str, Any],
        consecutive_errors: int,
    ) -> tuple[int, int, int]:
        earliest = BerlinTime.earliest_bookable_epoch(day)
        day_booked = 0
        day_stale = 0
        # Public and intern share one occupancy count, so the seats to create
        # are the larger of the two free lists — not the sum.
        if self.args.dry_run:
            estimates: list[int] = []
            for slot_type in SLOT_TYPES:
                if consecutive_errors >= MAX_CONSECUTIVE_ERRORS:
                    break
                progress, _stale, consecutive_errors, _saw = self._book_one_pass(
                    api,
                    scope_id,
                    requests,
                    day,
                    earliest,
                    slot_type,
                    entry,
                    consecutive_errors,
                )
                estimates.append(progress)
            estimate = max(estimates) if estimates else 0
            with self._lock:
                limit = self.args.max_bookings
                if limit and limit > 0:
                    estimate = min(
                        estimate, max(0, limit - self.report["totals"]["booked"])
                    )
                self.report["totals"]["booked"] += estimate
                entry["booked"] += estimate
            return estimate, 0, consecutive_errors

        for slot_type in SLOT_TYPES:
            passes = 0
            while not self._budget_reached() and consecutive_errors < MAX_CONSECUTIVE_ERRORS:
                passes += 1
                if passes > 5000:
                    print_log(f"scope {scope_id} {day} {slot_type}: pass cap reached")
                    break
                progress, stale, consecutive_errors, saw_slots = self._book_one_pass(
                    api,
                    scope_id,
                    requests,
                    day,
                    earliest,
                    slot_type,
                    entry,
                    consecutive_errors,
                )
                day_booked += progress
                day_stale += stale
                if not saw_slots or progress == 0:
                    break
        return day_booked, day_stale, consecutive_errors

    def _book_one_pass(
        self,
        api: ZmsApiClient,
        scope_id: int,
        requests: list[dict[str, Any]],
        day: date,
        earliest: int,
        slot_type: str,
        entry: dict[str, Any],
        consecutive_errors: int,
    ) -> tuple[int, int, int, bool]:
        """
        One sweep of every service.

        Dry-run counts the busiest service only (shared seats are not summed).
        Live booking walks every service so disjoint opening hours are filled.
        """
        progress = 0
        stale = 0
        saw_slots = False
        busiest = 0
        by_id, neighbors = combinable_graph(requests)
        for service_request in requests:
            if self._budget_reached() or consecutive_errors >= MAX_CONSECUTIVE_ERRORS:
                break
            try:
                slots = api.list_free_slots(
                    scope_id, [service_request], day, earliest, slot_type
                )
            except ZmsApiError as error:
                consecutive_errors += 1
                self._note_error(entry, f"{day} {slot_type} free: {error}")
                print_log(f"ERROR scope {scope_id} free {day} {slot_type}: {error}")
                continue
            if not slots:
                continue
            saw_slots = True
            if self.args.dry_run:
                busiest = max(busiest, len(slots))
                continue

            seed = request_id(service_request)
            for slot in slots:
                if self._budget_reached() or consecutive_errors >= MAX_CONSECUTIVE_ERRORS:
                    break
                group = self._group_for_slot(service_request, seed, by_id, neighbors)
                label = service_label(group)
                try:
                    outcome = api.reserve_and_confirm(
                        group, slot, self._next_family_name(scope_id), slot_type
                    )
                except ZmsApiError as error:
                    consecutive_errors += 1
                    self._note_error(entry, f"{day} {slot_type} {label}: {error}")
                    print_log(
                        f"ERROR scope {scope_id} book {day} {slot_type} "
                        f"{label}: {error}"
                    )
                    time.sleep(self.args.pause)
                    continue
                if outcome != "booked" and len(group) > 1:
                    # Combined slot count did not fit. Book the single seat.
                    try:
                        outcome = api.reserve_and_confirm(
                            [service_request],
                            slot,
                            self._next_family_name(scope_id),
                            slot_type,
                        )
                    except ZmsApiError as error:
                        consecutive_errors += 1
                        self._note_error(entry, f"{day} {slot_type} {label}: {error}")
                        print_log(
                            f"ERROR scope {scope_id} book {day} {slot_type} "
                            f"{label}: {error}"
                        )
                        time.sleep(self.args.pause)
                        continue
                    group = [service_request]
                    label = service_label(group)
                if outcome == "booked":
                    progress += 1
                    consecutive_errors = 0
                    booked_total = self._bump("booked", entry, "booked")
                    mix = self._record_service_count(len(group))
                    if not PROGRESS.tty and (booked_total <= 3 or booked_total % 50 == 0):
                        print_log(
                            f"scope {scope_id} booked {slot_type} {label} "
                            f"total={booked_total} mix[{mix}]"
                        )
                else:
                    stale += 1
                    self._bump("stale", entry, "stale")
                time.sleep(self.args.pause)

        if self.args.dry_run:
            return busiest, 0, consecutive_errors, busiest > 0
        return progress, stale, consecutive_errors, saw_slots

    def _group_for_slot(
        self,
        service_request: dict[str, Any],
        seed: str,
        by_id: dict[str, dict[str, Any]],
        neighbors: dict[str, set[str]],
    ) -> list[dict[str, Any]]:
        if self.args.service_name or not seed or seed not in by_id:
            return [service_request]
        max_size = len(largest_clique(seed, neighbors, limit=12))
        with self._lock:
            size = roll_service_count(self._rng, max_size)
            if size <= 1:
                return [service_request]
            return bundle_of_size(seed, by_id, neighbors, size, self._rng)

    def _record_service_count(self, size: int) -> str:
        with self._lock:
            self._service_counts[size] = self._service_counts.get(size, 0) + 1
            parts: list[str] = []
            for count_size, _weight in SERVICE_COUNT_WEIGHTS:
                count = self._service_counts.get(count_size, 0)
                if count == 0:
                    continue
                label = "single" if count_size == 1 else f"+{count_size - 1}"
                parts.append(f"{label}:{count}")
            return " ".join(parts)

    def _progress_line_unlocked(self) -> str:
        total = self._days_total
        done = min(self._days_done, total) if total else 0
        booked = int((self.report.get("totals") or {}).get("booked") or 0)
        width = 30
        filled = int(width * done / total) if total else 0
        bar = "#" * filled + "-" * (width - filled)
        return f"[{bar}] bookings {booked}  days {done}/{total}"

    def _show_progress(self) -> None:
        with self._lock:
            line = self._progress_line_unlocked()
        PROGRESS.show(line)

    def _bump(
        self, key: str, entry: dict[str, Any] | None = None, field: str | None = None
    ) -> int:
        with self._lock:
            self.report["totals"][key] += 1
            if entry is not None and field is not None:
                value = int(entry.get(field) or 0) + 1
                entry[field] = value
            else:
                value = int(self.report["totals"][key])
            line = self._progress_line_unlocked() if key == "booked" else ""
        if line:
            PROGRESS.show(line)
        return value

    def _note_error(self, entry: dict[str, Any], message: str) -> None:
        with self._lock:
            self.report["totals"]["errors"] += 1
            if len(entry["errors"]) < 10:
                entry["errors"].append(message[:300])

    def _finish_scope(self, entry: dict[str, Any], skipped: bool) -> None:
        with self._lock:
            if skipped:
                self.report["totals"]["skipped_scopes"] += 1
            self.report["scopes"].append(entry)
            self._write_report_unlocked()

    def _write_report(self) -> None:
        with self._lock:
            self._write_report_unlocked()

    def _write_report_unlocked(self) -> None:
        with open(self.args.report, "w", encoding="utf-8") as report_file:
            json.dump(self.report, report_file, indent=2, ensure_ascii=False)
            report_file.write("\n")

    def _validate(self) -> None:
        args = self.args
        if not args.base_url:
            raise SystemExit("BOOK_API_BASE_URL / --base-url is required")
        if not args.username:
            raise SystemExit("BOOK_USERNAME / --username is required")
        if not args.password:
            raise SystemExit("BOOK_PASSWORD / --password is required")
        if args.pause < 0:
            raise SystemExit("--pause must be >= 0")
        if args.days is not None and args.days < 0:
            raise SystemExit("--days must be >= 0")
        if args.max_bookings is not None and args.max_bookings < 0:
            raise SystemExit("--max-bookings must be >= 0")
        if args.workers < 0:
            raise SystemExit(
                f"--workers must be >= 0 (0 = {DEFAULT_WORKERS}, max {MAX_WORKERS})"
            )


def build_argument_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--base-url", default=os.environ.get("BOOK_API_BASE_URL", ""))
    parser.add_argument("--environment", default=os.environ.get("ENVIRONMENT", ""))
    parser.add_argument(
        "--username",
        default=os.environ.get("BOOK_USERNAME", os.environ.get("FILL_QUEUE_USERNAME", "")),
    )
    parser.add_argument(
        "--password",
        default=os.environ.get("BOOK_PASSWORD", os.environ.get("FILL_QUEUE_PASSWORD", "")),
    )
    parser.add_argument(
        "--from-day",
        default=os.environ.get("BOOK_FROM", "today"),
        help="First day to fill (today or YYYY-MM-DD). No past days.",
    )
    parser.add_argument(
        "--days",
        type=int,
        default=optional_int("BOOK_DAYS"),
        help=(
            "Last day as an offset from today (0 = today only). "
            "Default: each scope's endInDaysDefault."
        ),
    )
    parser.add_argument(
        "--scope-ids",
        default=os.environ.get("BOOK_SCOPE_IDS", ""),
        help="Comma-separated scope ids. Empty = every scope.",
    )
    parser.add_argument(
        "--service-name",
        default=os.environ.get("BOOK_SERVICE_NAME", "") or None,
        help="Only book this service (exact name, else substring). Default: every service.",
    )
    parser.add_argument(
        "--max-bookings",
        type=int,
        default=optional_int("BOOK_MAX_BOOKINGS"),
        help="Stop after this many confirmed appointments. Default: no cap.",
    )
    parser.add_argument(
        "--pause",
        type=float,
        default=environment_float("BOOK_PAUSE", PAUSE_BETWEEN_REQUESTS_SECONDS),
        help="Seconds between reserve/confirm calls.",
    )
    parser.add_argument(
        "--workers",
        type=int,
        default=environment_int("BOOK_WORKERS", 0),
        help=(
            "Scope-days in flight at once. "
            f"0 or empty = {DEFAULT_WORKERS} (max {MAX_WORKERS})."
        ),
    )
    parser.add_argument(
        "--name-prefix",
        default=os.environ.get("BOOK_NAME_PREFIX", "LOADTEST-local"),
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        default=environment_flag("BOOK_DRY_RUN"),
        help="Count free seats (busiest service per day) and do not reserve.",
    )
    parser.add_argument(
        "--insecure",
        action="store_true",
        default=environment_flag("BOOK_INSECURE_TLS"),
    )
    parser.add_argument(
        "--report",
        default=os.environ.get("BOOK_REPORT_PATH", "fill-opening-hours-report.json"),
    )
    return parser


def main() -> int:
    arguments = build_argument_parser().parse_args()
    job = OpeningHoursJob(arguments)
    try:
        return job.run()
    finally:
        if job.report:
            job._write_report()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except ZmsApiError as error:
        print_log(f"FATAL: {error}")
        if error.response_body:
            print_log(error.response_body[:1000])
        sys.exit(1)
