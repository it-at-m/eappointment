#!/usr/bin/env python3
"""
Fill ZMS queues with mock walk-ins and timed appointments (via zmsapi).

Hard limits: 700 processes per scope, 2800 per cluster.
Timed appointments: only slots at/after now (Europe/Berlin); never past slots.

Env / CLI — see --help. Local only.
"""

from __future__ import annotations

import argparse
import json
import os
import random
import ssl
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from dataclasses import dataclass, field
from datetime import date, datetime, timedelta, timezone
from typing import Any

try:
    from zoneinfo import ZoneInfo

    BERLIN_TIMEZONE = ZoneInfo("Europe/Berlin")
except Exception:  # pragma: no cover - minimal images without tzdata
    BERLIN_TIMEZONE = timezone(timedelta(hours=1))


# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------

MAX_PROCESSES_PER_SCOPE = 700
MAX_PROCESSES_PER_CLUSTER = 2800
PAUSE_BETWEEN_REQUESTS_SECONDS = 0.15
MAX_SLOT_RESERVE_ATTEMPTS = 8
HTTP_TIMEOUT_SECONDS = 120
LOADTEST_CUSTOMER_EMAIL = "test@muenchen.de"

# ~1/4 of processes try a combinable multi-service bundle; rest are random singles.
DEFAULT_COMBINABLE_SHARE = 0.25
# Among combinable attempts: most 2×, some 3×, few 4×, rare 5× (if graph allows).
BUNDLE_SIZE_WEIGHTS = (
    (2, 55),
    (3, 28),
    (4, 12),
    (5, 5),
)
# If DLDB combinable graph has no same-scope edges, still build multi-service
# bundles from any requests offered at the scope (admin/intern path allows this).
DEFAULT_SAME_SCOPE_BUNDLE_FALLBACK = True

LOCAL_API_HOSTS = frozenset({"127.0.0.1", "localhost", "web"})


# ---------------------------------------------------------------------------
# Errors & logging
# ---------------------------------------------------------------------------


class ZmsApiError(RuntimeError):
    """HTTP or logical failure talking to zmsapi."""

    def __init__(self, message: str, status_code: int = 0, response_body: str = ""):
        super().__init__(message)
        self.status_code = status_code
        self.response_body = response_body


def print_log(message: str) -> None:
    print(message, flush=True)


class Environment:
    """Read FILL_* / CI env vars for the CLI defaults."""

    @staticmethod
    def flag(name: str) -> bool:
        return os.environ.get(name, "").lower() in {"1", "true", "yes"}

    @staticmethod
    def int(name: str, default: int) -> int:
        return int(os.environ.get(name, str(default)) or default)

    @staticmethod
    def float(name: str, default: float) -> float:
        return float(os.environ.get(name, str(default)) or default)


# ---------------------------------------------------------------------------
# Europe/Berlin time (ZMS / ATAF appointment clock)
# ---------------------------------------------------------------------------


class BerlinTime:
    """
    Wall-clock helpers in Europe/Berlin — same timezone ZMS uses for openings
    and slots (cf. ATAF BerlinTime). Not a general calendar library.
    """

    @staticmethod
    def now() -> datetime:
        return datetime.now(BERLIN_TIMEZONE)

    @classmethod
    def parse_day(cls, value: str) -> date:
        if not value or value.lower() == "today":
            return cls.now().date()
        return date.fromisoformat(value)

    @staticmethod
    def start_of_day(day: date) -> datetime:
        return datetime(day.year, day.month, day.day, tzinfo=BERLIN_TIMEZONE)

    @classmethod
    def earliest_bookable_epoch(cls, day: date) -> int:
        """First bookable unix time on that day (never before “now” on today)."""
        now = cls.now()
        if day < now.date():
            raise SystemExit(f"Refusing day {day}: it is in the past")
        if day > now.date():
            return int(cls.start_of_day(day).timestamp())

        # Same-day: round to current minute (ATAF-style), never book past slots.
        epoch = int(now.timestamp())
        current_minute = epoch - (epoch % 60)
        if epoch % 60 <= 40:
            return current_minute
        return current_minute + 60

    @classmethod
    def end_of_day_epoch(cls, day: date) -> int:
        return int((cls.start_of_day(day) + timedelta(days=1)).timestamp())

def appointment_start_epoch(process: dict[str, Any]) -> int:
    """Unix epoch of the first appointment on a free/reserved process."""
    appointments = process.get("appointments") or [{}]
    try:
        return int((appointments[0] or {}).get("date") or 0)
    except (TypeError, ValueError, IndexError):
        return 0


def mock_customer(family_name: str) -> dict[str, Any]:
    return {
        "familyName": family_name,
        "email": LOADTEST_CUSTOMER_EMAIL,
        "surveyAccepted": 1,
    }


