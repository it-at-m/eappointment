class ZmsApiClient:
    """Thin client for the workstation / process endpoints we need to fill queues."""

    def __init__(self, base_url: str, verify_tls: bool = True):
        self.base_url = base_url.rstrip("/") + "/"
        self.auth_key: str | None = None
        self.workstation_scope_id: int | None = None
        self._ssl_context = ssl.create_default_context()
        if not verify_tls:
            self._ssl_context.check_hostname = False
            self._ssl_context.verify_mode = ssl.CERT_NONE

    def _extract_data(self, payload: Any) -> Any:
        if isinstance(payload, dict):
            return payload.get("data")
        return None

    def _request(
        self,
        method: str,
        path: str,
        body: Any = None,
        query: dict[str, Any] | None = None,
        use_auth: bool = True,
    ) -> tuple[int, Any]:
        url = urllib.parse.urljoin(self.base_url, path.lstrip("/"))
        if query:
            separator = "&" if "?" in url else "?"
            filtered = {key: value for key, value in query.items() if value is not None}
            url += separator + urllib.parse.urlencode(filtered)

        raw_body = None
        headers = {"Accept": "application/json"}
        if body is not None:
            raw_body = json.dumps(body).encode("utf-8")
            headers["Content-Type"] = "application/json"
        if use_auth:
            if not self.auth_key:
                raise ZmsApiError("Not logged in")
            headers["X-AuthKey"] = self.auth_key

        request = urllib.request.Request(
            url, data=raw_body, headers=headers, method=method
        )
        try:
            with urllib.request.urlopen(
                request, context=self._ssl_context, timeout=HTTP_TIMEOUT_SECONDS
            ) as response:
                raw = response.read().decode("utf-8", errors="replace")
                status_code = response.getcode()
        except urllib.error.HTTPError as error:
            raw = error.read().decode("utf-8", errors="replace")
            raise ZmsApiError(
                f"{method} {path} -> HTTP {error.code}",
                status_code=error.code,
                response_body=raw[:2000],
            ) from error
        except urllib.error.URLError as error:
            raise ZmsApiError(f"{method} {path} failed: {error}") from error

        try:
            parsed = json.loads(raw) if raw else None
        except json.JSONDecodeError:
            parsed = raw
        return status_code, parsed

    def _require_http_ok(self, status_code: int, payload: Any, message: str) -> Any:
        if status_code != 200:
            raise ZmsApiError(
                message, status_code=status_code, response_body=str(payload)[:1000]
            )
        return self._extract_data(payload)

    # -- auth / workstation -------------------------------------------------

    def login_with_password(self, username: str, password: str) -> None:
        """
        Local password login (same as admin UI form).
        Use the exact login name.
        """
        login_name = username.strip()
        status_code, payload = self._request(
            "POST",
            "/workstation/login/",
            body={
                "id": login_name,
                "password": password,
                "departments": [{"id": 0}],
            },
            use_auth=False,
        )
        if status_code < 200 or status_code >= 300:
            raise ZmsApiError(
                f"login as {login_name!r} failed HTTP {status_code} "
                f"(plaintext password; id must match the UI login name exactly)",
                status_code=status_code,
                response_body=str(payload)[:1000],
            )
        workstation = self._extract_data(payload) or {}
        auth_key = workstation.get("authkey") or workstation.get("authKey")
        if not auth_key:
            raise ZmsApiError(
                "login ok but no authkey in response",
                response_body=str(payload)[:1000],
            )
        self.auth_key = auth_key
        print_log(f"Logged in as {login_name}")

    def assign_workstation_to_scope(
        self, scope_id: int, counter_name: str = "fill"
    ) -> None:
        status_code, payload = self._request(
            "GET", "/workstation/", query={"resolveReferences": 2}
        )
        workstation = self._require_http_ok(
            status_code, payload, f"GET /workstation/ -> {status_code}"
        ) or {}

        workstation["name"] = counter_name
        scope = workstation.get("scope")
        if not isinstance(scope, dict):
            scope = {}
        scope["id"] = scope_id
        workstation["scope"] = scope

        useraccount = workstation.get("useraccount")
        if isinstance(useraccount, dict):
            useraccount.pop("departments", None)

        status_code, payload = self._request("POST", "/workstation/", body=workstation)
        self._require_http_ok(
            status_code,
            payload,
            f"POST /workstation/ scope={scope_id} -> {status_code}",
        )
        self.workstation_scope_id = scope_id

    # -- lookups ------------------------------------------------------------

    def list_scope_ids_in_cluster(self, cluster_id: int) -> list[int]:
        status_code, payload = self._request(
            "GET", f"/cluster/{cluster_id}/", query={"resolveReferences": 1}
        )
        cluster = self._require_http_ok(
            status_code, payload, f"GET /cluster/{cluster_id}/ -> {status_code}"
        ) or {}
        scopes = cluster.get("scopes") or []
        scope_ids = [
            int(scope["id"])
            for scope in scopes
            if isinstance(scope, dict) and scope.get("id")
        ]
        if not scope_ids:
            raise ZmsApiError(
                f"cluster {cluster_id} has no scopes",
                response_body=str(payload)[:1000],
            )
        return scope_ids

    def list_scope_requests(self, scope_id: int) -> list[dict[str, Any]]:
        status_code, payload = self._request(
            "GET",
            f"/scope/{scope_id}/request/",
            query={"resolveReferences": 1},
        )
        requests = self._require_http_ok(
            status_code, payload, f"GET /scope/{scope_id}/request/ -> {status_code}"
        )
        if not isinstance(requests, list) or not requests:
            raise ZmsApiError(f"scope {scope_id} has no requests")
        return [request for request in requests if isinstance(request, dict)]

    def find_service_request(
        self, scope_id: int, service_name: str | None
    ) -> dict[str, Any]:
        requests = self.list_scope_requests(scope_id)
        if not service_name:
            return requests[0]

        needle = service_name.lower()
        exact_match = next(
            (
                request
                for request in requests
                if str(request.get("name", "")).lower() == needle
            ),
            None,
        )
        if exact_match:
            return exact_match

        partial_matches = sorted(
            (
                request
                for request in requests
                if needle in str(request.get("name", "")).lower()
            ),
            key=lambda request: len(str(request.get("name", ""))),
        )
        if partial_matches:
            print_log(
                f"scope {scope_id}: matched request "
                f"'{partial_matches[0].get('name')}' for '{service_name}'"
            )
            return partial_matches[0]

        print_log(
            f"scope {scope_id}: '{service_name}' not found; "
            f"using '{requests[0].get('name')}'"
        )
        return requests[0]

    def list_free_appointment_slots(
        self,
        scope_id: int,
        service_requests: list[dict[str, Any]],
        day: date,
        earliest_epoch: int,
    ) -> list[dict[str, Any]]:
        calendar = {
            "firstDay": {"year": day.year, "month": day.month, "day": day.day},
            "lastDay": {"year": day.year, "month": day.month, "day": day.day},
            "scopes": [{"id": scope_id}],
            "requests": list(service_requests),
        }
        status_code, payload = self._request(
            "POST",
            "/process/status/free/",
            body=calendar,
            query={"slotType": "intern", "slotsRequired": 0},
        )
        free_list = self._require_http_ok(
            status_code,
            payload,
            f"POST /process/status/free/ scope={scope_id} -> {status_code}",
        )
        if not isinstance(free_list, list):
            return []

        day_end = BerlinTime.end_of_day_epoch(day)
        slots = [
            process
            for process in free_list
            if isinstance(process, dict)
            and earliest_epoch <= appointment_start_epoch(process) <= day_end
        ]
        slots.sort(key=appointment_start_epoch)
        return slots

    # -- create processes ---------------------------------------------------

    def create_walk_in_customer(
        self,
        scope_id: int,
        service_requests: list[dict[str, Any]],
        family_name: str,
        amendment: str,
        dry_run: bool,
    ) -> int | None:
        if dry_run:
            return None
        process = {
            "status": "queued",
            "amendment": amendment,
            "scope": {"id": scope_id},
            "appointments": [{"scope": {"id": scope_id}, "date": 0}],
            "requests": list(service_requests),
            "clients": [mock_customer(family_name)],
        }
        status_code, payload = self._request(
            "POST", "/workstation/process/waitingnumber/", body=process
        )
        created = self._require_http_ok(
            status_code, payload, f"walk-in scope={scope_id} -> {status_code}"
        ) or {}
        return int(created.get("id") or 0) or None

    def reserve_and_confirm_appointment(
        self,
        scope_id: int,
        service_requests: list[dict[str, Any]],
        free_slot_process: dict[str, Any],
        family_name: str,
        dry_run: bool,
    ) -> int | None:
        """Reserve + confirm one free slot. Returns process id, or None if raced."""
        if dry_run:
            return None

        process = dict(free_slot_process)
        process["requests"] = list(service_requests)
        process["clients"] = [mock_customer(family_name)]

        try:
            status_code, payload = self._request(
                "POST",
                "/process/status/reserved/",
                body=process,
                query={"slotType": "intern", "clientkey": "", "slotsRequired": 0},
            )
        except ZmsApiError as error:
            # _request raises on HTTP 404, so a lost race never returns a status code.
            if error.status_code == 404:
                return None
            raise
        reserved = self._require_http_ok(
            status_code, payload, f"reserve scope={scope_id} -> {status_code}"
        )
        if not reserved:
            return None

        status_code, payload = self._request(
            "POST", "/process/status/confirmed/", body=reserved
        )
        confirmed = self._require_http_ok(
            status_code, payload, f"confirm scope={scope_id} -> {status_code}"
        ) or {}
        return int(confirmed.get("id") or 0) or None

    # -- list / delete (queue wipe) -----------------------------------------

    def list_processes_for_day(self, scope_id: int, day: date) -> list[dict[str, Any]]:
        day_path = day.isoformat()
        status_code, payload = self._request(
            "GET", f"/scope/{scope_id}/process/{day_path}/"
        )
        data = self._require_http_ok(
            status_code,
            payload,
            f"GET /scope/{scope_id}/process/{day_path}/ -> {status_code}",
        )
        if not isinstance(data, list):
            return []
        return [process for process in data if isinstance(process, dict)]

    def list_processes_by_status(
        self, scope_id: int, status: str
    ) -> list[dict[str, Any]]:
        status_code, payload = self._request(
            "GET", f"/scope/{scope_id}/process/status/{status}/"
        )
        data = self._require_http_ok(
            status_code,
            payload,
            f"GET /scope/{scope_id}/process/status/{status}/ -> {status_code}",
        )
        if not isinstance(data, list):
            return []
        return [process for process in data if isinstance(process, dict)]

    def delete_process(self, process_id: int, dry_run: bool) -> bool:
        """Admin quick-delete (DELETE /process/{id}/). Skips called/processing."""
        if dry_run:
            return True
        if process_id <= 0:
            return True
        try:
            status_code, payload = self._request(
                "DELETE",
                f"/process/{process_id}/",
                query={"initiator": "fill-queue-wipe"},
            )
        except ZmsApiError as error:
            # Already gone is fine; other failures (called/processing) bubble up.
            if error.status_code == 404:
                return True
            raise
        if status_code == 200:
            return True
        raise ZmsApiError(
            f"DELETE /process/{process_id}/ -> {status_code}",
            status_code=status_code,
            response_body=str(payload)[:1000],
        )


# ---------------------------------------------------------------------------
# Service mix (random singles + combinable bundles)
# ---------------------------------------------------------------------------


def request_id(request: dict[str, Any]) -> str:
    value = request.get("id")
    return "" if value is None else str(value)


def request_data_object(request: dict[str, Any]) -> dict[str, Any]:
    """Normalize request.data (object or JSON string from API)."""
    data = request.get("data")
    if isinstance(data, dict):
        return data
    if isinstance(data, str) and data.strip():
        try:
            parsed = json.loads(data)
        except json.JSONDecodeError:
            return {}
        if isinstance(parsed, dict):
            return parsed
    return {}


def request_combinable_ids(request: dict[str, Any]) -> set[str]:
    """DLDB `data.combinable` service ids (may include self)."""
    data = request_data_object(request)
    raw = data.get("combinable") or []
    ids: set[str] = set()
    if not isinstance(raw, list):
        return ids
    for entry in raw:
        if isinstance(entry, dict):
            entry = entry.get("id")
        if entry is not None and str(entry) != "":
            ids.add(str(entry))
    return ids


def service_names(service_requests: list[dict[str, Any]]) -> str:
    return " + ".join(
        str(request.get("name") or request_id(request)) for request in service_requests
    )


class ServiceMixPicker:
    """
    Pick services for each process:
    - ~75% random single service from the scope
    - ~25% multi-service (2× mostly, then 3× / 4× / rare 5×)
      Prefer DLDB data.combinable partners that are also on this scope.
      If that graph is empty, optionally fall back to any same-scope mix
      (admin walk-in / intern booking still accepts multiple requests).
    Fixed --service-name disables mixing (always that one request).
    """

    def __init__(
        self,
        scope_requests: list[dict[str, Any]],
        *,
        fixed_request: dict[str, Any] | None = None,
        mix_services: bool = True,
        combinable_share: float = DEFAULT_COMBINABLE_SHARE,
        same_scope_bundle_fallback: bool = DEFAULT_SAME_SCOPE_BUNDLE_FALLBACK,
        rng: random.Random | None = None,
    ):
        self.scope_requests = list(scope_requests)
        self.fixed_request = fixed_request
        self.mix_services = mix_services and fixed_request is None
        self.combinable_share = max(0.0, min(1.0, combinable_share))
        self.same_scope_bundle_fallback = same_scope_bundle_fallback
        self.rng = rng or random.Random()
        self.by_id = {
            request_id(request): request
            for request in self.scope_requests
            if request_id(request)
        }
        self.neighbors = self._build_combinable_graph()
        self.dldb_edge_count = sum(len(peers) for peers in self.neighbors.values()) // 2
        self.use_same_scope_fallback = (
            self.same_scope_bundle_fallback
            and self.dldb_edge_count == 0
            and len(self.scope_requests) >= 2
        )
        with_combinable_field = sum(
            1 for request in self.scope_requests if request_combinable_ids(request)
        )
        print_log(
            f"service mix: {len(self.scope_requests)} requests, "
            f"{with_combinable_field} with data.combinable, "
            f"{self.dldb_edge_count} same-scope DLDB edges, "
            f"fallback_same_scope={self.use_same_scope_fallback}, "
            f"mix={self.mix_services}, combinable_share={self.combinable_share}"
        )
        if self.mix_services and self.dldb_edge_count == 0:
            if self.use_same_scope_fallback:
                print_log(
                    "No DLDB combinable partners share this scope; "
                    "using random same-scope multi-service bundles instead"
                )
            else:
                print_log(
                    "No DLDB combinable partners share this scope; "
                    "multi-service bundles disabled "
                    "(enable same-scope fallback or pick another scope)"
                )

    def _build_combinable_graph(self) -> dict[str, set[str]]:
        graph: dict[str, set[str]] = {rid: set() for rid in self.by_id}
        for rid, request in self.by_id.items():
            for other in request_combinable_ids(request):
                if other != rid and other in self.by_id:
                    graph[rid].add(other)
                    graph[other].add(rid)
        return graph

    def pick(self) -> list[dict[str, Any]]:
        if self.fixed_request is not None:
            return [self.fixed_request]
        if not self.scope_requests:
            raise ZmsApiError("no scope requests to pick from")
        if not self.mix_services or len(self.scope_requests) == 1:
            return [self.rng.choice(self.scope_requests)]

        if self.rng.random() < self.combinable_share:
            bundle = self._pick_multi_service_bundle()
            if len(bundle) >= 2:
                return bundle
        return [self.rng.choice(self.scope_requests)]

    def _pick_bundle_size(self) -> int:
        sizes = [size for size, _weight in BUNDLE_SIZE_WEIGHTS]
        weights = [weight for _size, weight in BUNDLE_SIZE_WEIGHTS]
        return self.rng.choices(sizes, weights=weights, k=1)[0]

    def _pick_multi_service_bundle(self) -> list[dict[str, Any]]:
        if self.dldb_edge_count > 0:
            bundle = self._pick_dldb_combinable_bundle()
            if len(bundle) >= 2:
                return bundle
        if self.use_same_scope_fallback:
            return self._pick_same_scope_bundle()
        return []

    def _pick_dldb_combinable_bundle(self) -> list[dict[str, Any]]:
        """Grow a clique-ish bundle via DLDB neighbor intersection."""
        target_size = self._pick_bundle_size()
        seeds = [rid for rid, peers in self.neighbors.items() if peers]
        if not seeds:
            return []

        for size in range(target_size, 1, -1):
            for _ in range(12):
                seed = self.rng.choice(seeds)
                bundle_ids = [seed]
                candidates = set(self.neighbors[seed])
                while len(bundle_ids) < size and candidates:
                    nxt = self.rng.choice(sorted(candidates))
                    bundle_ids.append(nxt)
                    candidates &= self.neighbors[nxt]
                    candidates -= set(bundle_ids)
                if len(bundle_ids) >= size:
                    return [self.by_id[rid] for rid in bundle_ids]
                if len(bundle_ids) >= 2 and size == 2:
                    return [self.by_id[rid] for rid in bundle_ids]
        return []

    def _pick_same_scope_bundle(self) -> list[dict[str, Any]]:
        """Any distinct requests offered at this scope (no DLDB combinable edge)."""
        target_size = min(self._pick_bundle_size(), len(self.scope_requests))
        if target_size < 2:
            return []
        return self.rng.sample(self.scope_requests, target_size)


