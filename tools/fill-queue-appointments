@dataclass
class ScopeFillResult:
    scope_id: int
    requested_walk_ins: int
    requested_appointments: int
    created_walk_ins: int = 0
    created_appointments: int = 0
    skipped: int = 0
    errors: list[str] = field(default_factory=list)
    process_ids: list[int] = field(default_factory=list)

    def as_report_dict(self) -> dict[str, Any]:
        # Keep JSON keys stable for existing consumers.
        return {
            "scope_id": self.scope_id,
            "requested_spontaneous": self.requested_walk_ins,
            "requested_appointments": self.requested_appointments,
            "created_spontaneous": self.created_walk_ins,
            "created_appointments": self.created_appointments,
            "skipped": self.skipped,
            "errors": self.errors,
            "process_ids": self.process_ids,
        }

    @property
    def created_total(self) -> int:
        return self.created_walk_ins + self.created_appointments


class ScopeQueueFiller:
    """Create walk-ins and/or timed appointments for a single scope."""

    def __init__(
        self,
        api: ZmsApiClient,
        scope_id: int,
        service_picker: ServiceMixPicker,
        day: date,
        earliest_epoch: int,
        customer_name_prefix: str,
        dry_run: bool,
        scope_budget: int,
        fill_to_capacity: bool,
    ):
        self.api = api
        self.scope_id = scope_id
        self.service_picker = service_picker
        self.day = day
        self.earliest_epoch = earliest_epoch
        self.customer_name_prefix = customer_name_prefix
        self.dry_run = dry_run
        self.scope_budget = scope_budget
        self.fill_to_capacity = fill_to_capacity

    def fill(
        self, walk_in_count: int, appointment_count: int
    ) -> ScopeFillResult:
        result = ScopeFillResult(
            scope_id=self.scope_id,
            requested_walk_ins=walk_in_count,
            requested_appointments=appointment_count,
        )
        self.api.assign_workstation_to_scope(self.scope_id)
        created_so_far = self._create_walk_ins(result, walk_in_count)
        self._create_appointments(result, appointment_count, created_so_far)
        return result

    def _create_walk_ins(self, result: ScopeFillResult, count: int) -> int:
        created_so_far = 0
        for index in range(count):
            if created_so_far >= self.scope_budget:
                result.skipped += count - index
                break
            family_name = (
                f"{self.customer_name_prefix}-S-{self.scope_id}-{index + 1:04d}"
            )
            service_requests = self.service_picker.pick()
            try:
                process_id = self.api.create_walk_in_customer(
                    self.scope_id,
                    service_requests,
                    family_name,
                    amendment=self.customer_name_prefix,
                    dry_run=self.dry_run,
                )
            except ZmsApiError as error:
                result.errors.append(
                    f"walk-in: {error} {error.response_body[:200]}"
                )
                print_log(f"ERROR scope {self.scope_id} walk-in: {error}")
                break
            result.created_walk_ins += 1
            created_so_far += 1
            if process_id:
                result.process_ids.append(process_id)
            if index < 3 or len(service_requests) > 1:
                print_log(
                    f"scope {self.scope_id} walk-in: {service_names(service_requests)}"
                )
            time.sleep(PAUSE_BETWEEN_REQUESTS_SECONDS)
        return created_so_far

    def _try_book_bundle(
        self,
        service_requests: list[dict[str, Any]],
        family_name: str,
    ) -> tuple[bool, int | None]:
        """Fetch free slots for this service mix and try to book one."""
        free_slots = self.api.list_free_appointment_slots(
            self.scope_id,
            service_requests,
            self.day,
            self.earliest_epoch,
        )
        if not free_slots:
            return False, None
        tried = 0
        for candidate in free_slots:
            # Walk-ins can run long enough that the planned cutoff minute is already past.
            if appointment_start_epoch(candidate) < int(BerlinTime.now().timestamp()):
                continue
            if tried >= MAX_SLOT_RESERVE_ATTEMPTS:
                break
            tried += 1
            process_id = self.api.reserve_and_confirm_appointment(
                self.scope_id,
                service_requests,
                candidate,
                family_name,
                dry_run=self.dry_run,
            )
            if self.dry_run or process_id:
                return True, process_id
        return False, None

    def _create_appointments(
        self,
        result: ScopeFillResult,
        appointment_count: int,
        created_so_far: int,
    ) -> None:
        if self.fill_to_capacity:
            # One service can have no seats while another still does.
            appointment_count = max(0, self.scope_budget - created_so_far)
            result.requested_appointments = appointment_count
            print_log(
                f"scope {self.scope_id}: fill_capacity up to {appointment_count} "
                "appointments, trying each offered service"
            )

        booked_count = 0
        empty_streak = 0
        while booked_count < appointment_count and created_so_far < self.scope_budget:
            service_requests = self.service_picker.pick()
            family_name = (
                f"{self.customer_name_prefix}-A-{self.scope_id}-{booked_count + 1:04d}"
            )
            try:
                booked, process_id = self._try_book_bundle(
                    service_requests, family_name
                )
            except ZmsApiError as error:
                result.errors.append(f"book: {error} {error.response_body[:200]}")
                print_log(f"ERROR scope {self.scope_id} book: {error}")
                booked = False
                process_id = None

            if not booked:
                empty_streak += 1
                # Retries with other mixes; stop after several empty tries.
                if empty_streak >= 5:
                    result.skipped += appointment_count - booked_count
                    break
                continue

            empty_streak = 0
            result.created_appointments += 1
            created_so_far += 1
            booked_count += 1
            if process_id:
                result.process_ids.append(process_id)
            if booked_count <= 3 or len(service_requests) > 1:
                print_log(
                    f"scope {self.scope_id} appointment: "
                    f"{service_names(service_requests)}"
                )
            time.sleep(PAUSE_BETWEEN_REQUESTS_SECONDS)


