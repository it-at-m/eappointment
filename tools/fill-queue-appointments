@dataclass
class FillRequest:
    """What the operator asked for (after mode/count parsing)."""

    target_kind: str  # "scope" | "cluster"
    target_id: int
    mode: str
    walk_in_count: int
    appointment_count: int
    fill_to_capacity: bool
    service_name: str | None
    day: date
    earliest_epoch: int
    customer_name_prefix: str
    dry_run: bool


class FillPlanner:
    """Turn counts + caps into per-scope budgets."""

    @staticmethod
    def refuse_if_production(base_url: str, environment: str) -> None:
        env = (environment or "").strip().lower()
        if env in {"prod", "production"}:
            raise SystemExit("Refusing to run when ENVIRONMENT is prod")
        host = urllib.parse.urlparse(base_url).hostname or ""
        if host not in LOCAL_API_HOSTS:
            raise SystemExit("Refusing a non-local API URL")

    @staticmethod
    def assert_within_hard_limits(
        target_kind: str, walk_in_count: int, appointment_count: int
    ) -> None:
        total = walk_in_count + appointment_count
        limit = (
            MAX_PROCESSES_PER_SCOPE
            if target_kind == "scope"
            else MAX_PROCESSES_PER_CLUSTER
        )
        if total > limit:
            raise SystemExit(
                f"Requested {total} exceeds {target_kind} hard limit {limit}"
            )

    @staticmethod
    def spread_evenly(total_count: int, scope_count: int) -> list[int]:
        if scope_count <= 0:
            return []
        base, remainder = divmod(total_count, scope_count)
        return [base + (1 if index < remainder else 0) for index in range(scope_count)]

    @classmethod
    def counts_from_cli(cls, args: argparse.Namespace) -> tuple[int, int]:
        """Return (walk_in_count, appointment_count) from mode/count flags."""
        if args.mode == "fill_capacity":
            cap = (
                MAX_PROCESSES_PER_SCOPE
                if args.target == "scope"
                else MAX_PROCESSES_PER_CLUSTER
            )
            return 0, cap

        if args.mode == "spontaneous":
            count = (
                args.spontaneous_count if args.spontaneous_count >= 0 else args.count
            )
            if count <= 0:
                raise SystemExit("Set --count or --spontaneous-count > 0")
            return count, 0

        if args.mode == "appointments":
            count = (
                args.appointment_count if args.appointment_count >= 0 else args.count
            )
            if count <= 0:
                raise SystemExit("Set --count or --appointment-count > 0")
            return 0, count

        # mixed
        if args.spontaneous_count >= 0 or args.appointment_count >= 0:
            walk_ins = max(0, args.spontaneous_count)
            appointments = max(0, args.appointment_count)
            if walk_ins + appointments <= 0:
                raise SystemExit("mixed needs spontaneous and/or appointment counts")
            return walk_ins, appointments

        if args.count <= 0:
            raise SystemExit(
                "mixed needs --count or explicit spontaneous/appointment counts"
            )
        walk_ins = int(round(args.count * args.spontaneous_ratio))
        walk_ins = min(max(walk_ins, 0), args.count)
        return walk_ins, args.count - walk_ins

    @classmethod
    def budgets_per_scope(
        cls,
        target_kind: str,
        scope_ids: list[int],
        walk_in_count: int,
        appointment_count: int,
        fill_to_capacity: bool,
    ) -> tuple[list[int], list[int]]:
        scope_count = len(scope_ids)

        if fill_to_capacity:
            if target_kind == "scope":
                return [0], [MAX_PROCESSES_PER_SCOPE]
            share = min(
                MAX_PROCESSES_PER_SCOPE,
                MAX_PROCESSES_PER_CLUSTER // max(scope_count, 1),
            )
            appointments_per_scope = [share] * scope_count
            leftover = MAX_PROCESSES_PER_CLUSTER - share * scope_count
            for index in range(leftover):
                slot = index % scope_count
                appointments_per_scope[slot] = min(
                    MAX_PROCESSES_PER_SCOPE, appointments_per_scope[slot] + 1
                )
            return [0] * scope_count, appointments_per_scope

        walk_ins_per_scope = cls.spread_evenly(walk_in_count, scope_count)
        appointments_per_scope = cls.spread_evenly(appointment_count, scope_count)
        for index, scope_id in enumerate(scope_ids):
            planned = walk_ins_per_scope[index] + appointments_per_scope[index]
            if planned > MAX_PROCESSES_PER_SCOPE:
                raise SystemExit(
                    f"Plan for scope {scope_id} is {planned} > {MAX_PROCESSES_PER_SCOPE}"
                )
        return walk_ins_per_scope, appointments_per_scope

    @staticmethod
    def fit_into_budget(
        walk_in_count: int, appointment_count: int, scope_budget: int
    ) -> tuple[int, int]:
        if walk_in_count + appointment_count <= scope_budget:
            return walk_in_count, appointment_count
        # Prefer keeping walk-ins; shrink timed appointments first.
        appointment_count = max(0, scope_budget - walk_in_count)
        walk_in_count = min(walk_in_count, scope_budget)
        return walk_in_count, appointment_count


