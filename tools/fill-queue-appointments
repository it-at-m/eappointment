def build_argument_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--base-url", default=os.environ.get("FILL_API_BASE_URL", ""))
    parser.add_argument("--environment", default=os.environ.get("ENVIRONMENT", ""))
    parser.add_argument(
        "--username",
        default=os.environ.get("FILL_QUEUE_USERNAME", "_system_queuefill"),
        help="Exact ZMS login name. The local CLI passes _system_queuefill.",
    )
    parser.add_argument(
        "--password",
        default=os.environ.get("FILL_QUEUE_PASSWORD", ""),
        help="Password from FILL_QUEUE_PASSWORD. The local CLI passes the local test password.",
    )
    parser.add_argument(
        "--target",
        choices=("scope", "cluster"),
        default=os.environ.get("FILL_TARGET", "scope"),
    )
    parser.add_argument(
        "--target-id", type=int, default=Environment.int("FILL_TARGET_ID", 0)
    )
    parser.add_argument(
        "--mode",
        choices=("spontaneous", "appointments", "mixed", "fill_capacity"),
        default=os.environ.get("FILL_MODE", "spontaneous"),
    )
    parser.add_argument(
        "--count",
        type=int,
        default=Environment.int("FILL_COUNT", 0),
        help=(
            "Total to create (spontaneous/appointments/mixed). "
            "Ignored for fill_capacity."
        ),
    )
    parser.add_argument(
        "--spontaneous-count",
        type=int,
        default=Environment.int("FILL_SPONTANEOUS_COUNT", -1),
    )
    parser.add_argument(
        "--appointment-count",
        type=int,
        default=Environment.int("FILL_APPOINTMENT_COUNT", -1),
    )
    parser.add_argument(
        "--spontaneous-ratio",
        type=float,
        default=Environment.float("FILL_SPONTANEOUS_RATIO", 0.5),
        help="For mixed when only --count is set (default 0.5).",
    )
    parser.add_argument(
        "--service-name",
        default=os.environ.get("FILL_SERVICE_NAME", "") or None,
        help="Pin every process to this service (disables mix/combinables).",
    )
    _mix_env = os.environ.get("FILL_MIX_SERVICES", "true").lower()
    parser.add_argument(
        "--mix-services",
        action=argparse.BooleanOptionalAction,
        default=_mix_env not in {"0", "false", "no"},
        help=(
            "Randomize services per process; ~1/4 combinable multi-service "
            "(default on). Use --no-mix-services to disable."
        ),
    )
    parser.add_argument(
        "--combinable-share",
        type=float,
        default=Environment.float(
            "FILL_COMBINABLE_SHARE", DEFAULT_COMBINABLE_SHARE
        ),
        help="Fraction of processes that attempt a combinable bundle (default 0.25).",
    )
    _fallback_env = os.environ.get("FILL_SAME_SCOPE_BUNDLE_FALLBACK", "true").lower()
    parser.add_argument(
        "--same-scope-bundle-fallback",
        action=argparse.BooleanOptionalAction,
        default=_fallback_env not in {"0", "false", "no"},
        help=(
            "If DLDB combinable has no same-scope partners, still create "
            "multi-service bundles from any requests on the scope (default on)."
        ),
    )
    _seed_env = os.environ.get("FILL_RANDOM_SEED", "").strip()
    parser.add_argument(
        "--random-seed",
        type=int,
        default=int(_seed_env) if _seed_env else None,
        help="Optional RNG seed for reproducible mixes.",
    )
    parser.add_argument("--day", default=os.environ.get("FILL_DAY", "today"))
    parser.add_argument(
        "--name-prefix",
        default=os.environ.get("FILL_NAME_PREFIX", "LOADTEST-local"),
    )
    parser.add_argument(
        "--wipe-queue",
        choices=("none", "before", "only"),
        default=os.environ.get("FILL_WIPE_QUEUE", "none"),
        help=(
            "Delete queue processes: none (default), before fill, or only wipe. "
            "Uses DELETE /process/{id}/ (skips called/processing)."
        ),
    )
    _wipe_all_env = os.environ.get("FILL_WIPE_ALL", "false").lower()
    parser.add_argument(
        "--wipe-all",
        action=argparse.BooleanOptionalAction,
        default=_wipe_all_env in {"1", "true", "yes"},
        help=(
            "With --wipe-queue: delete every deletable process for the day "
            "(default off = only names starting with --wipe-name-prefix)."
        ),
    )
    parser.add_argument(
        "--wipe-name-prefix",
        default=os.environ.get("FILL_WIPE_NAME_PREFIX", "LOADTEST-"),
        help="When not --wipe-all, only delete clients whose familyName starts with this.",
    )
    parser.add_argument(
        "--dry-run", action="store_true", default=Environment.flag("FILL_DRY_RUN")
    )
    parser.add_argument(
        "--insecure",
        action="store_true",
        default=Environment.flag("FILL_INSECURE_TLS"),
    )
    parser.add_argument(
        "--report",
        default=os.environ.get("FILL_REPORT_PATH", "fill-queue-report.json"),
    )
    return parser


def main() -> int:
    arguments = build_argument_parser().parse_args()
    return QueueFillJob(arguments).run()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except ZmsApiError as error:
        print_log(f"FATAL: {error}")
        if error.response_body:
            print_log(error.response_body[:1000])
        sys.exit(1)
