SKIP_WIPE_STATUSES = frozenset({"called", "processing", "blocked", "deleted"})


def process_family_name(process: dict[str, Any]) -> str:
    clients = process.get("clients") or []
    if clients and isinstance(clients[0], dict):
        return str(clients[0].get("familyName") or "")
    return ""


def process_appointment_day(process: dict[str, Any]) -> date | None:
    epoch = appointment_start_epoch(process)
    if epoch <= 0:
        return None
    return datetime.fromtimestamp(epoch, BERLIN_TIMEZONE).date()


def process_matches_wipe_filter(
    process: dict[str, Any], *, wipe_all: bool, name_prefix: str
) -> bool:
    if wipe_all:
        return True
    family = process_family_name(process)
    return bool(name_prefix) and family.startswith(name_prefix)


@dataclass
class ScopeWipeResult:
    scope_id: int
    listed: int = 0
    deleted: int = 0
    skipped: int = 0
    errors: list[str] = field(default_factory=list)

    def as_report_dict(self) -> dict[str, Any]:
        return {
            "scope_id": self.scope_id,
            "listed": self.listed,
            "deleted": self.deleted,
            "skipped": self.skipped,
            "errors": self.errors,
        }


class QueueWiper:
    """Delete today's queue / appointment processes for a scope via admin API."""

    def __init__(
        self,
        api: ZmsApiClient,
        scope_id: int,
        day: date,
        *,
        wipe_all: bool,
        name_prefix: str,
        dry_run: bool,
    ):
        self.api = api
        self.scope_id = scope_id
        self.day = day
        self.wipe_all = wipe_all
        self.name_prefix = name_prefix
        self.dry_run = dry_run

    def wipe(self) -> ScopeWipeResult:
        result = ScopeWipeResult(scope_id=self.scope_id)
        self.api.assign_workstation_to_scope(self.scope_id, counter_name="wipe")

        by_id: dict[int, dict[str, Any]] = {}
        for process in self.api.list_processes_for_day(self.scope_id, self.day):
            pid = int(process.get("id") or 0)
            if pid > 0:
                by_id[pid] = process
        for status in ("queued", "confirmed", "reserved"):
            try:
                for process in self.api.list_processes_by_status(self.scope_id, status):
                    pid = int(process.get("id") or 0)
                    # The status list is not limited to --day.
                    if pid > 0 and process_appointment_day(process) == self.day:
                        by_id[pid] = process
            except ZmsApiError as error:
                # Some statuses may be empty / unsupported — keep going.
                print_log(
                    f"scope {self.scope_id}: skip status={status} list: {error}"
                )

        result.listed = len(by_id)
        filter_label = "all" if self.wipe_all else f"prefix={self.name_prefix!r}"
        print_log(
            f"scope {self.scope_id}: wipe candidates listed={result.listed} "
            f"filter={filter_label} dry_run={self.dry_run}"
        )

        for process_id, process in sorted(by_id.items()):
            status = str(process.get("status") or "")
            if status in SKIP_WIPE_STATUSES:
                result.skipped += 1
                continue
            if not process_matches_wipe_filter(
                process, wipe_all=self.wipe_all, name_prefix=self.name_prefix
            ):
                result.skipped += 1
                continue
            family = process_family_name(process)
            try:
                self.api.delete_process(process_id, dry_run=self.dry_run)
            except ZmsApiError as error:
                # called/processing etc.
                result.errors.append(f"{process_id}: {error}")
                result.skipped += 1
                print_log(f"scope {self.scope_id}: skip delete {process_id}: {error}")
                continue
            result.deleted += 1
            if result.deleted <= 5 or result.deleted % 50 == 0:
                print_log(
                    f"scope {self.scope_id}: deleted process {process_id} "
                    f"status={status} name={family!r}"
                )
            time.sleep(PAUSE_BETWEEN_REQUESTS_SECONDS)

        print_log(
            f"scope {self.scope_id}: wipe done deleted={result.deleted} "
            f"skipped={result.skipped} errors={len(result.errors)}"
        )
        return result


