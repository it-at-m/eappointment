class QueueFillJob:
    """Orchestrate login → plan → fill scopes → write report."""

    def __init__(self, args: argparse.Namespace):
        self.args = args

    def run(self) -> int:
        self._validate_arguments()
        FillPlanner.refuse_if_production(self.args.base_url, self.args.environment)

        day = BerlinTime.parse_day(self.args.day)
        # Rejects a past day before any wipe. The fill uses the same cutoff.
        earliest_epoch = BerlinTime.earliest_bookable_epoch(day)
        wipe_mode = self.args.wipe_queue  # none | before | only
        fill_after_wipe = wipe_mode != "only"

        api = ZmsApiClient(self.args.base_url, verify_tls=not self.args.insecure)
        api.login_with_password(self.args.username, self.args.password)

        if self.args.target == "scope":
            scope_ids = [self.args.target_id]
        else:
            scope_ids = api.list_scope_ids_in_cluster(self.args.target_id)
            print_log(f"cluster {self.args.target_id} scopes: {scope_ids}")

        report: dict[str, Any] = {
            "base_url": self.args.base_url,
            "environment": self.args.environment,
            "target": self.args.target,
            "target_id": self.args.target_id,
            "mode": self.args.mode,
            "wipe_queue": wipe_mode,
            "wipe_all": self.args.wipe_all,
            "wipe_name_prefix": self.args.wipe_name_prefix,
            "day": str(day),
            "dry_run": self.args.dry_run,
            "name_prefix": self.args.name_prefix,
            "scope_ids": scope_ids,
            "wipes": [],
            "scopes": [],
            "totals": {
                "wiped": 0,
                "wipe_skipped": 0,
                "wipe_errors": 0,
                "created_spontaneous": 0,
                "created_appointments": 0,
                "skipped": 0,
                "errors": 0,
            },
        }

        fill_to_capacity = self.args.mode == "fill_capacity"
        walk_in_count = 0
        appointment_count = 0
        walk_ins_per_scope: list[int] = []
        appointments_per_scope: list[int] = []
        if fill_after_wipe:
            walk_in_count, appointment_count = FillPlanner.counts_from_cli(self.args)
            FillPlanner.assert_within_hard_limits(
                self.args.target, walk_in_count, appointment_count
            )
            walk_ins_per_scope, appointments_per_scope = FillPlanner.budgets_per_scope(
                self.args.target,
                scope_ids,
                walk_in_count,
                appointment_count,
                fill_to_capacity,
            )

        if wipe_mode in {"before", "only"}:
            if self.args.wipe_all and not self.args.dry_run:
                print_log(
                    "WARNING: wipe_all=true deletes all deletable processes "
                    "for the day on target scope(s) (not only LOADTEST-*)"
                )
            for scope_id in scope_ids:
                wiper = QueueWiper(
                    api,
                    scope_id,
                    day,
                    wipe_all=self.args.wipe_all,
                    name_prefix=self.args.wipe_name_prefix,
                    dry_run=self.args.dry_run,
                )
                wipe_result = wiper.wipe()
                report["wipes"].append(wipe_result.as_report_dict())
                report["totals"]["wiped"] += wipe_result.deleted
                report["totals"]["wipe_skipped"] += wipe_result.skipped
                report["totals"]["wipe_errors"] += len(wipe_result.errors)

        if fill_after_wipe:
            report["earliest_epoch"] = earliest_epoch

            processes_created_in_cluster = 0
            for index, scope_id in enumerate(scope_ids):
                remaining_cluster_budget = (
                    MAX_PROCESSES_PER_CLUSTER - processes_created_in_cluster
                )
                if self.args.target == "cluster" and remaining_cluster_budget <= 0:
                    break

                scope_budget = MAX_PROCESSES_PER_SCOPE
                if self.args.target == "cluster":
                    scope_budget = min(
                        MAX_PROCESSES_PER_SCOPE, remaining_cluster_budget
                    )

                planned_walk_ins, planned_appointments = FillPlanner.fit_into_budget(
                    walk_ins_per_scope[index],
                    appointments_per_scope[index],
                    scope_budget,
                )
                scope_requests = api.list_scope_requests(scope_id)
                fixed_request = None
                if self.args.service_name:
                    fixed_request = api.find_service_request(
                        scope_id, self.args.service_name
                    )
                seed = self.args.random_seed
                rng = (
                    random.Random(seed + scope_id)
                    if seed is not None
                    else random.Random()
                )
                service_picker = ServiceMixPicker(
                    scope_requests,
                    fixed_request=fixed_request,
                    mix_services=self.args.mix_services,
                    combinable_share=self.args.combinable_share,
                    same_scope_bundle_fallback=self.args.same_scope_bundle_fallback,
                    rng=rng,
                )
                print_log(
                    f"=== scope {scope_id}: walk_ins={planned_walk_ins} "
                    f"appointments={planned_appointments} "
                    f"mix_services={self.args.mix_services} "
                    f"dry_run={self.args.dry_run}"
                )

                filler = ScopeQueueFiller(
                    api=api,
                    scope_id=scope_id,
                    service_picker=service_picker,
                    day=day,
                    earliest_epoch=earliest_epoch,
                    customer_name_prefix=self.args.name_prefix,
                    dry_run=self.args.dry_run,
                    scope_budget=scope_budget,
                    fill_to_capacity=fill_to_capacity,
                )
                scope_result = filler.fill(planned_walk_ins, planned_appointments)
                report["scopes"].append(scope_result.as_report_dict())

                processes_created_in_cluster += scope_result.created_total
                totals = report["totals"]
                totals["created_spontaneous"] += scope_result.created_walk_ins
                totals["created_appointments"] += scope_result.created_appointments
                totals["skipped"] += scope_result.skipped
                totals["errors"] += len(scope_result.errors)

        with open(self.args.report, "w", encoding="utf-8") as report_file:
            json.dump(report, report_file, indent=2, ensure_ascii=False)
            report_file.write("\n")
        print_log(f"Wrote report {self.args.report}")
        print_log(json.dumps(report["totals"], indent=2))

        totals = report["totals"]
        created_any = (
            totals["created_spontaneous"] + totals["created_appointments"]
        )
        wiped_any = totals["wiped"] > 0
        if totals["errors"] and created_any == 0 and not wiped_any:
            return 1
        if wipe_mode == "only" and totals["wipe_errors"] and not wiped_any:
            return 1
        return 0

    def _validate_arguments(self) -> None:
        args = self.args
        if not args.base_url:
            raise SystemExit("FILL_API_BASE_URL / --base-url is required")
        if not args.username:
            raise SystemExit("FILL_QUEUE_USERNAME / --username is required")
        if not args.password:
            raise SystemExit("FILL_QUEUE_PASSWORD / --password is required")
        if args.target_id <= 0:
            raise SystemExit("FILL_TARGET_ID / --target-id must be a positive id")
        if args.wipe_queue not in {"none", "before", "only"}:
            raise SystemExit("--wipe-queue must be none, before, or only")
        if args.wipe_all and args.wipe_queue == "none":
            raise SystemExit("--wipe-all requires --wipe-queue before|only")
        if args.wipe_queue != "none" and not args.wipe_all and not args.wipe_name_prefix:
            raise SystemExit(
                "--wipe-name-prefix is required when wiping without --wipe-all"
            )


