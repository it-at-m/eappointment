{
    "name": "eappointment/zmsslim",
    "description": "Basic configuration for a slim framework",
    "license": "MIT",
    "authors": [
        {
            "name": "Mathias Fischer",
            "email": "mathias.fischer@berlinonline.de"
        }
    ],
    "config": {
        "platform": {
            "php": "8.4.1"
        }
    },
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "ext-posix": "*",
        "slim/slim": "4.*",
        "twig/twig": "3.*",
        "monolog/monolog": "^3.0",
        "slim/twig-view": "3.*",
        "slim/http-cache": "1.*",
        "eappointment/mellon": "@dev",
        "symfony/translation": "^8.0",
        "symfony/twig-bridge": "^8.0",
        "stevenmaguire/oauth2-keycloak": "^6.0",
        "slim/psr7": "^1.5",
        "tracy/tracy": "^2.9",
        "roave/security-advisories": "dev-latest",
        "psr/simple-cache": "^3.0",
        "symfony/cache": "^8.0",
        "ezyang/htmlpurifier": "^4.18",
        "league/commonmark": "^2.7"
    },
    "require-dev": {
        "vimeo/psalm": "6.5.0",
        "phpmd/phpmd": "@stable",
        "squizlabs/php_codesniffer": "*",
        "phpunit/phpunit": "^13",
        "roave/security-advisories": "dev-latest"
    },
    "scripts": {
        "command": "bin/configure"
    },
    "autoload": {
        "psr-4": {
            "BO\\Slim\\": "src/Slim/",
            "BO\\Slim\\Tests\\": "tests/Slim/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BO\\Zmsclient\\": "../zmsclient/src/Zmsclient/",
            "BO\\Zmsentities\\": "../zmsentities/src/Zmsentities/"
        }
    },
    "provide": {
        "psr/container-implementation": "2.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../*",
            "options": {
                "symlink": true
            }
        }
    ]
}
