<?xml version="1.0"?>
<psalm
    errorLevel="7"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    findUnusedBaselineEntry="true"
    findUnusedCode="false"
>
    <projectFiles>
        <directory name="src" />
        <file name="config.example.php" />
        <ignoreFiles>
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>
    <!--
      Soft deps used by OAuth middleware; not Composer-required to avoid
      circular zmsclient <-> zmsslim. Stubs only for package Psalm.
    -->
    <stubs>
        <file name="stubs/zmsclient.php" />
        <file name="stubs/zmsclient-psr7.php" />
        <file name="stubs/zmsentities.php" />
    </stubs>
</psalm>
