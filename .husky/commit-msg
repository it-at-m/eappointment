#!/bin/sh

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

. "$(dirname "$0")/validate-commit-message.sh"

commit_msg=$(head -n 1 "$1")

echo "Running commit message check..."
validate_commit_message "$commit_msg" || exit 1

echo "Running Vue code style check..."
if ! (cd zmscitizenview && npm run lint); then
  printf "${RED}✗ Vue lint failed. Please fix the errors before committing.${NC}\n"
  exit 1
fi
printf "${GREEN}✓ Vue code style OK.${NC}\n"

echo "Running docs formatting check..."
if ! (cd docs && npm run format:check); then
  printf "${RED}✗ Docs Prettier check failed. Please fix the errors before committing.${NC}\n"
  echo "  cd docs && npm run format"
  echo "  (Run 'cd docs && npm install' first if dependencies are missing.)"
  exit 1
fi
printf "${GREEN}✓ Docs formatting OK.${NC}\n"

staged_files=$(git diff --cached --name-only --diff-filter=ACMR)
js_modules="zmsadmin zmscalldisplay zmsstatistic zmsticketprinter"
js_to_lint=""
for module in $js_modules; do
  if echo "$staged_files" | grep -E "^${module}/(js/|eslint\\.config\\.|package(-lock)?\\.json)" >/dev/null; then
    js_to_lint="$js_to_lint $module"
  fi
done
# Skip PHP unless a PHP source file (or PHPMD rules) changed — JS-only files in those modules must not wait on phpcs/phpmd.
php_relevant=$(echo "$staged_files" | grep -E '\.php$|phpmd\.rules\.xml$' || true)

container_engine=""
ensure_container_engine() {
  if [ -n "$container_engine" ]; then
    return
  fi
  if command -v podman >/dev/null 2>&1 && podman ps --format "{{.Names}}" | grep -q "^zms-web$"; then
    container_engine="podman"
  elif command -v docker >/dev/null 2>&1 && docker ps --format "{{.Names}}" | grep -q "^zms-web$"; then
    container_engine="docker"
  fi
}

if [ -n "$js_to_lint" ]; then
  ensure_container_engine
  echo "Running frontend ESLint..."
  for module in $js_to_lint; do
    echo "  $module"
    if [ -n "$container_engine" ]; then
      if ! $container_engine exec zms-web bash -lc "cd $module && npm run lint"; then
        printf "${RED}✗ ESLint failed in $module. Please fix the errors before committing.${NC}\n"
        echo "  $container_engine exec -it zms-web bash -lc \"cd $module && npm run fix\""
        exit 1
      fi
    else
      if ! (cd "$module" && npm run lint); then
        printf "${RED}✗ ESLint failed in $module. Please fix the errors before committing.${NC}\n"
        echo "  podman exec -it zms-web bash -lc \"cd $module && npm run fix\""
        echo "  (or: cd $module && npm run fix — run npm install first if dependencies are missing.)"
        exit 1
      fi
    fi
  done
  printf "${GREEN}✓ Frontend ESLint OK.${NC}\n"
else
  printf "${YELLOW}⚠ No admin/statistic/calldisplay/ticketprinter JS changes staged. Skipping ESLint.${NC}\n"
fi

if [ -z "$php_relevant" ]; then
  printf "${YELLOW}⚠ No PHP source changes staged. Skipping PHP code style and PHPMD checks.${NC}\n"
  exit 0
fi

ensure_container_engine

if [ -n "$container_engine" ]; then
  echo "Running PHP code style check..."
  phpcs_output=$($container_engine exec zms-web bash -lc "./cli modules loop 'vendor/bin/phpcs --standard=psr12 src/'" 2>&1)
  phpcs_status=$?
  if [ "$phpcs_status" -gt 2 ]; then
    printf "${RED}✗ PHP CodeSniffer failed to run (container exec error).${NC}\n"
    echo "$phpcs_output"
    exit 1
  fi
  total_error_count=$(echo "$phpcs_output" | grep -Eo "FOUND [0-9]+ ERROR" | awk '{sum+=$2} END {print sum+0}')

  if [ "$total_error_count" -gt 0 ]; then
    printf "${RED}✗ PHP CodeSniffer found $total_error_count error(s).${NC}\n"
    echo "You can fix them with:"
    echo "  $container_engine exec -it zms-web bash -lc \"./cli modules loop 'vendor/bin/phpcbf --standard=psr12 src/'\""
    exit 1
  else
    printf "${GREEN}✓ PHP code style OK.${NC}\n"
  fi

  # Same command as .github/workflows/php-code-quality.yaml (complexity / size / unused).
  echo "Running PHP Mess Detector check..."
  phpmd_output=$($container_engine exec zms-web bash -lc "./cli modules loop 'vendor/bin/phpmd src/ text ../phpmd.rules.xml'" 2>&1)
  phpmd_status=$?
  if [ "$phpmd_status" -gt 2 ]; then
    printf "${RED}✗ PHPMD failed to run (container exec error).${NC}\n"
    echo "$phpmd_output"
    exit 1
  fi
  # cli modules loop ignores per-module exit codes; detect PHPMD text-format violations.
  phpmd_violations=$(echo "$phpmd_output" | grep -E '\.php:[0-9]+[[:space:]]+[A-Za-z]+' || true)
  if [ -n "$phpmd_violations" ]; then
    printf "${RED}✗ PHPMD found rule violations (see phpmd.rules.xml).${NC}\n"
    echo "$phpmd_output"
    echo "Re-run with:"
    echo "  $container_engine exec -it zms-web bash -lc \"./cli modules loop 'vendor/bin/phpmd src/ text ../phpmd.rules.xml'\""
    exit 1
  else
    printf "${GREEN}✓ PHP Mess Detector OK.${NC}\n"
  fi
else
  printf "${YELLOW}⚠ zms-web container is not running. Skipping PHP code style and PHPMD checks.${NC}\n"
fi
