                            "default": false
                        },
                        "notificationHeadsUpEnabled": {
                            "type": [
                                "boolean",
                                "number"
                            ],
                            "description": "true if client should get a notification as reminder (Convienient preferences, see department for origin)",
                            "default": false
                        },
